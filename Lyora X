            TriggerBtn.Text               = ""
            TriggerBtn.Parent             = ToggleFrame

            local function SetState(val)
                Toggled = val
                LunoLibrary.Flags[Flag] = Toggled
                TweenService:Create(Switch, TweenInfo.new(0.2), {
                    BackgroundColor3 = Toggled
                        and Color3.fromRGB(0, 102, 255)
