-- ── Generic Helpers ───────────────────────────────────────
local function Create(class, props)
    local inst = Instance.new(class)
    local parent
    for k, v in pairs(props or {}) do
        if k == "Parent" then parent = v else inst[k] = v end
    end
    if parent then inst.Parent = parent end
    return inst
end

local function AddCorner(obj, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = (typeof(r) == "UDim") and r or UDim.new(0, r)
    c.Parent = obj
    return c
end

-- ── Shimmer System (chrome border animation, 1 loop only) ─
local ShimmerGradients = {}
RegisterConnection(RunService.Heartbeat:Connect(function(dt)
    for i = #ShimmerGradients, 1, -1 do
        local g = ShimmerGradients[i]
        if g.Parent then
            g.Rotation = (g.Rotation + dt * 22) % 360
        else
            table.remove(ShimmerGradients, i)
        end
    end
end))
local function RegisterShimmer(grad)
    table.insert(ShimmerGradients, grad)
    return grad
end

local function AddChromeStroke(parent, thickness, transparency, shimmer)
    local st = Instance.new("UIStroke")
    st.Color           = Y2K.Neon
    st.Thickness       = thickness or 1
    st.Transparency    = transparency or 0.5
    st.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    st.Parent          = parent
    if shimmer then
        local g = Instance.new("UIGradient")
        g.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0,   Y2K.Chrome),
            ColorSequenceKeypoint.new(0.5, Y2K.Neon),
            ColorSequenceKeypoint.new(1,   Y2K.Chrome),
        })
        g.Parent = st
        RegisterShimmer(g)
    end
    return st
end

local function AddChromeText(label, rot)
    local g = Instance.new("UIGradient")
    g.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0,   Y2K.Chrome),
        ColorSequenceKeypoint.new(0.5, Y2K.NeonSoft),
        ColorSequenceKeypoint.new(1,   Y2K.Chrome),
    })
    g.Rotation = rot or 90
    g.Parent = label
    return g
end

local function AddHoverGlow(obj, stroke, offT, onT)
    offT = offT or 0.6
    onT  = onT  or 0.05
    obj.MouseEnter:Connect(function()
        TweenService:Create(stroke, TweenInfo.new(0.15), {Transparency = onT}):Play()
    end)
    obj.MouseLeave:Connect(function()
        TweenService:Create(stroke, TweenInfo.new(0.15), {Transparency = offT}):Play()
    end)
end

