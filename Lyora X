local ThemeRegistry = {}
local function Themed(inst, prop, key)
    table.insert(ThemeRegistry, {Instance = inst, Prop = prop, Key = key})
    pcall(function() inst[prop] = Y2K[key] end)
    return inst
end

local function ApplyTheme(newTheme)
    for k, v in pairs(newTheme or {}) do Y2K[k] = v end
    for _, entry in ipairs(ThemeRegistry) do
        if entry.Instance and entry.Instance.Parent then
            pcall(function() entry.Instance[entry.Prop] = Y2K[entry.Key] end)
        end
    end
end

local FontBody  = Enum.Font.GothamMedium
