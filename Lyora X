function LunoLibrary:Notify(Settings)
    Settings = Settings or {}
    local Title = Settings.Title or "Notification"
    local Content = Settings.Content or "Notification details here."
    local Duration = Settings.Duration or 3

    local Toast = Instance.new("Frame")
    Toast.Size = UDim2.new(1, 0, 0, 0)
    Toast.BackgroundColor3 = Color3.fromRGB(14, 20, 34)
    Toast.ClipsDescendants = true
    Toast.Parent = NotifyContainer

    local ToastCorner = Instance.new("UICorner")
    ToastCorner.CornerRadius = UDim.new(0, 8)
    ToastCorner.Parent = Toast

    local ToastStroke = Instance.new("UIStroke")
    ToastStroke.Color = Color3.fromRGB(0, 110, 255)
    ToastStroke.Thickness = 1
    ToastStroke.Transparency = 0.3
    ToastStroke.Parent = Toast

    local ToastTitle = Instance.new("TextLabel")
    ToastTitle.Size = UDim2.new(1, -16, 0, 18)
    ToastTitle.Position = UDim2.new(0, 10, 0, 6)
    ToastTitle.BackgroundTransparency = 1
    ToastTitle.Text = Title
    ToastTitle.TextColor3 = Color3.fromRGB(255, 255, 255)
    ToastTitle.TextSize = 11
    ToastTitle.Font = Enum.Font.GothamBold
    ToastTitle.TextXAlignment = Enum.TextXAlignment.Left
    ToastTitle.Parent = Toast

    local ToastContent = Instance.new("TextLabel")
    ToastContent.Size = UDim2.new(1, -16, 0, 26)
    ToastContent.Position = UDim2.new(0, 10, 0, 24)
    ToastContent.BackgroundTransparency = 1
    ToastContent.Text = Content
    ToastContent.TextColor3 = Color3.fromRGB(130, 150, 180)
    ToastContent.TextSize = 10
    ToastContent.Font = Enum.Font.Gotham
    ToastContent.TextXAlignment = Enum.TextXAlignment.Left
    ToastContent.TextWrapped = true
    ToastContent.Parent = Toast

    TweenService:Create(Toast, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Size = UDim2.new(1, 0, 0, 58)}):Play()

    task.delay(Duration, function()
        local tw = TweenService:Create(Toast, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {Size = UDim2.new(1, 0, 0, 0)})
        tw:Play()
        tw.Completed:Connect(function() Toast:Destroy() end)
    end)
end

function LunoLibrary:CreateWindow(Settings)
    Settings = Settings or {}
    local TitleText = Settings.Title or "LUNO"
    local SubTitleText = Settings.SubTitle or "by LUNAR"

    local BaseWidth = (DeviceType == "Mobile") and math.clamp(ViewportSize.X - 30, 480, 680) or 800
    local BaseHeight = (DeviceType == "Mobile") and math.clamp(ViewportSize.Y - 30, 320, 420) or 480

    -- MAIN FRAME
    local MainFrame = Instance.new("Frame")
    MainFrame.Name = "MainFrame"
    MainFrame.Size = UDim2.new(0, BaseWidth, 0, BaseHeight)
    MainFrame.Position = UDim2.new(0.5, -BaseWidth/2, 0.5, -BaseHeight/2)
    MainFrame.BackgroundColor3 = Color3.fromRGB(10, 14, 23)
    MainFrame.BorderSizePixel = 0
    MainFrame.ClipsDescendants = true
    MainFrame.Parent = MainScreenGui

    local MainCorner = Instance.new("UICorner")
    MainCorner.CornerRadius = UDim.new(0, 12)
    MainCorner.Parent = MainFrame

    local MainStroke = Instance.new("UIStroke")
    MainStroke.Color = Color3.fromRGB(0, 110, 255)
    MainStroke.Thickness = 1.2
    MainStroke.Transparency = 0.4
    MainStroke.Parent = MainFrame

    -- DRAGGING
    local Dragging, DragInput, DragStart, StartPos
    MainFrame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            Dragging = true
            DragStart = input.Position
            StartPos = MainFrame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then Dragging = false end
            end)
        end
    end)
    MainFrame.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then DragInput = input end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if input == DragInput and Dragging then
            local delta = input.Position - DragStart
            MainFrame.Position = UDim2.new(StartPos.X.Scale, StartPos.X.Offset + delta.X, StartPos.Y.Scale, StartPos.Y.Offset + delta.Y)
        end
    end)

    -- RESIZE HANDLE
    local ResizeHitbox = Instance.new("TextButton")
    ResizeHitbox.Name = "ResizeHitbox"
    ResizeHitbox.Size = UDim2.new(0, 36, 0, 36)
    ResizeHitbox.Position = UDim2.new(1, -36, 1, -36)
    ResizeHitbox.BackgroundTransparency = 1
    ResizeHitbox.Text = "◢"
    ResizeHitbox.TextColor3 = Color3.fromRGB(0, 140, 255)
    ResizeHitbox.TextSize = 16
    ResizeHitbox.Font = Enum.Font.GothamBold
    ResizeHitbox.ZIndex = 30
    ResizeHitbox.Parent = MainFrame

    local Resizing = false
    local ResizeStart, StartSize
    local MinSize = Vector2.new(550, 350)
    local MaxSize = Vector2.new(ViewportSize.X - 20, ViewportSize.Y - 20)

    ResizeHitbox.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            Resizing = true
            ResizeStart = input.Position
            StartSize = MainFrame.AbsoluteSize
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then Resizing = false end
            end)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if Resizing and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - ResizeStart
            MainFrame.Size = UDim2.new(0, math.clamp(StartSize.X + delta.X, MinSize.X, MaxSize.X), 0, math.clamp(StartSize.Y + delta.Y, MinSize.Y, MaxSize.Y))
        end
    end)

    ---------------------------------------------------------
    -- MOBILE & TABLET FLOATING POPUP ICON (DRAGGABLE)
    ---------------------------------------------------------
    local FloatingPopUp = Instance.new("Frame")
    FloatingPopUp.Name = "LunoFloatingPopUp"
    FloatingPopUp.Size = UDim2.new(0, 48, 0, 48)
    FloatingPopUp.Position = UDim2.new(0, 20, 0.4, 0)
    FloatingPopUp.BackgroundColor3 = Color3.fromRGB(12, 18, 32)
    FloatingPopUp.Visible = (DeviceType ~= "PC")
    FloatingPopUp.ZIndex = 99
    FloatingPopUp.Parent = MainScreenGui

    local FloatCorner = Instance.new("UICorner")
    FloatCorner.CornerRadius = UDim.new(1, 0)
    FloatCorner.Parent = FloatingPopUp

    local FloatStroke = Instance.new("UIStroke")
    FloatStroke.Color = Color3.fromRGB(0, 110, 255)
    FloatStroke.Thickness = 1.5
    FloatStroke.Parent = FloatingPopUp

    local FloatBtn = Instance.new("TextButton")
    FloatBtn.Size = UDim2.new(1, 0, 1, 0)
    FloatBtn.BackgroundTransparency = 1
    FloatBtn.Text = "LUNO"
    FloatBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    FloatBtn.Font = Enum.Font.GothamBlack
    FloatBtn.TextSize = 10
    FloatBtn.Parent = FloatingPopUp

    -- Make Floating Icon Draggable
    local FDrag, FInput, FStart, FStartPos
    FloatingPopUp.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            FDrag = true
            FStart = input.Position
            FStartPos = FloatingPopUp.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then FDrag = false end
            end)
        end
    end)
    FloatingPopUp.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then FInput = input end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if input == FInput and FDrag then
            local delta = input.Position - FStart
            FloatingPopUp.Position = UDim2.new(FStartPos.X.Scale, FStartPos.X.Offset + delta.X, FStartPos.Y.Scale, FStartPos.Y.Offset + delta.Y)
        end
    end)

    -- macOS WINDOW CONTROL DOTS
    local Controls = Instance.new("Frame")
    Controls.Size = UDim2.new(0, 45, 0, 15)
    Controls.Position = UDim2.new(1, -55, 0, 10)
    Controls.BackgroundTransparency = 1
    Controls.ZIndex = 15
    Controls.Parent = MainFrame

    local MinDot = Instance.new("TextButton")
    MinDot.Size = UDim2.new(0, 13, 0, 13)
    MinDot.BackgroundColor3 = Color3.fromRGB(255, 189, 46)
    MinDot.Text = ""
    MinDot.Parent = Controls
    local MinCorner = Instance.new("UICorner") MinCorner.CornerRadius = UDim.new(1, 0) MinCorner.Parent = MinDot

    local CloseDot = Instance.new("TextButton")
    CloseDot.Size = UDim2.new(0, 13, 0, 13)
    CloseDot.Position = UDim2.new(0, 20, 0, 0)
    CloseDot.BackgroundColor3 = Color3.fromRGB(255, 95, 86)
    CloseDot.Text = ""
    CloseDot.Parent = Controls
    local CloseCorner = Instance.new("UICorner") CloseCorner.CornerRadius = UDim.new(1, 0) CloseCorner.Parent = CloseDot

    local IsVisible = true
    local LastSize = MainFrame.Size

    local function ToggleUI()
        IsVisible = not IsVisible
        if IsVisible then
            MainFrame.Visible = true
            TweenService:Create(MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Size = LastSize}):Play()
            if DeviceType ~= "PC" then FloatingPopUp.Visible = true end
        else
            LastSize = MainFrame.Size
            local tw = TweenService:Create(MainFrame, TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {Size = UDim2.new(0, LastSize.X.Offset, 0, 0)})
            tw:Play()
            tw.Completed:Connect(function()
                if not IsVisible then
                    MainFrame.Visible = false
                    if DeviceType ~= "PC" then FloatingPopUp.Visible = true end
                end
            end)
        end
    end

    MinDot.MouseButton1Click:Connect(ToggleUI)
    FloatBtn.MouseButton1Click:Connect(ToggleUI)
    CloseDot.MouseButton1Click:Connect(function() MainScreenGui:Destroy() end)

    UserInputService.InputBegan:Connect(function(input, gpe)
        if not gpe and (input.KeyCode == Enum.KeyCode.RightControl or input.KeyCode == Enum.KeyCode.Insert) then ToggleUI() end
    end)

    ---------------------------------------------------------
    -- LEFT SIDEBAR & USER CARD
    ---------------------------------------------------------
