function AuraUI:_loadProfile()
    task.spawn(function()
        local ok, url = pcall(function()
            return Players:GetUserThumbnailAsync(
                LocalPlayer.UserId,
                Enum.ThumbnailType.HeadShot,
                Enum.ThumbnailSize.Size100x100)
        end)
        if ok and url and self.AvatarImg then
            self.AvatarImg.Image = url
        end
        if self.UserLabel then
            local dn = LocalPlayer.DisplayName
            self.UserLabel.Text = (dn ~= LocalPlayer.Name)
                and (dn.." • @"..LocalPlayer.Name)
                or  ("@"..LocalPlayer.Name)
        end
    end)
end

function AuraUI:_setupKeybind()
    UserInputService.InputBegan:Connect(function(input, gp)
        if gp then return end
        if input.KeyCode == self.Keybind then self:Toggle() end
    end)
end

function AuraUI:_buildMobileBtn()
    self.MobileBtn = Create("TextButton",{
        Name="MobileToggle",
        Size=UDim2.new(0,52,0,52), Position=UDim2.new(0,16,0.5,0),
        BackgroundColor3=Theme.Accent,
        Text="☰", TextColor3=Color3.fromRGB(255,255,255),
        TextSize=22, Font=Enum.Font.GothamBold,
        ZIndex=300, Parent=self.ScreenGui,
    })
    Corner(self.MobileBtn,16)
    Stroke(self.MobileBtn,Theme.AccentGlow,2)
    task.spawn(function()
        while self.MobileBtn and self.MobileBtn.Parent do
            Tween(self.MobileBtn,{BackgroundColor3=Theme.AccentGlow},0.9,
                Enum.EasingStyle.Sine,Enum.EasingDirection.InOut)
            task.wait(0.9)
            if not(self.MobileBtn and self.MobileBtn.Parent) then break end
            Tween(self.MobileBtn,{BackgroundColor3=Theme.Accent},0.9,
                Enum.EasingStyle.Sine,Enum.EasingDirection.InOut)
            task.wait(0.9)
        end
    end)
    MakeDraggable(self.MobileBtn,self.MobileBtn)
    self.MobileBtn.MouseButton1Click:Connect(function() self:Toggle() end)
end

function AuraUI:Toggle(state)
    if self.Animating then return end
    if state == nil then state = not self.Visible end
    self.Visible   = state
    self.Animating = true
    fadeWindow(self.MainFrame, self.Container, self.WinSize, state, function()
        self.Animating = false
    end)
    if self.MobileBtn then
        self.MobileBtn.Text = state and "✕" or "☰"
    end
end

