    function Tab:AddSlider(cfg)
        cfg=cfg or {}
        local label    = cfg.Name     or "Slider"
        local min      = cfg.Min      or 0
        local max      = cfg.Max      or 100
        local default  = cfg.Default  or min
        local suffix   = cfg.Suffix   or ""
        local callback = cfg.Callback or function() end
        local step     = cfg.Step     or 1
        local value    = math.clamp(default,min,max)

        local card=Card(66)
        Create("TextLabel",{
            Size=UDim2.new(1,-90,0,20), Position=UDim2.new(0,14,0,10),
            BackgroundTransparency=1, Text=label,
            TextColor3=Theme.TextPrimary, TextSize=13, Font=Enum.Font.GothamSemibold,
            TextXAlignment=Enum.TextXAlignment.Left,
            ZIndex=5, Parent=card,
        })
        local valLbl=Create("TextLabel",{
            Size=UDim2.new(0,80,0,20), Position=UDim2.new(1,-92,0,10),
            BackgroundTransparency=1, Text=tostring(value)..suffix,
            TextColor3=Theme.AccentGlow, TextSize=13, Font=Enum.Font.GothamBold,
            TextXAlignment=Enum.TextXAlignment.Right,
            ZIndex=5, Parent=card,
        })
        local track=Create("Frame",{
            Size=UDim2.new(1,-28,0,6), Position=UDim2.new(0,14,0,42),
            BackgroundColor3=Theme.SliderTrack, ZIndex=5, Parent=card,
        })
        Corner(track,99)
        local fill=Create("Frame",{
            Size=UDim2.new((value-min)/(max-min),0,1,0),
            BackgroundColor3=Theme.SliderFill,
            ZIndex=6, Parent=track,
        })
        Corner(fill,99)
        local fg=Instance.new("UIGradient")
        fg.Color=ColorSequence.new({
            ColorSequenceKeypoint.new(0,Theme.AccentSecondary),
            ColorSequenceKeypoint.new(1,Theme.Accent),
        })
        fg.Parent=fill
        local kn=Create("Frame",{
            Size=UDim2.new(0,16,0,16),
            Position=UDim2.new((value-min)/(max-min),-8,0.5,-8),
            BackgroundColor3=Color3.fromRGB(220,180,255),
            ZIndex=7, Parent=track,
        })
        Corner(kn,99) Stroke(kn,Theme.Accent,2)

        local function updateVal(inputX)
            local rel=math.clamp(inputX-track.AbsolutePosition.X,0,track.AbsoluteSize.X)
            local pct=rel/track.AbsoluteSize.X
            local raw=min+(max-min)*pct
            value=math.clamp(math.floor(raw/step+0.5)*step,min,max)
            local p=(value-min)/(max-min)
            Tween(fill,{Size=UDim2.new(p,0,1,0)},0.04)
            Tween(kn,  {Position=UDim2.new(p,-8,0.5,-8)},0.04)
            valLbl.Text=tostring(value)..suffix
            pcall(callback,value)
        end

        local dragging=false
        local sBtn=Create("TextButton",{
            Size=UDim2.new(1,0,3,0), Position=UDim2.new(0,0,-1,0),
            BackgroundTransparency=1, Text="", ZIndex=8, Parent=track,
        })
        sBtn.InputBegan:Connect(function(i)
            if i.UserInputType==Enum.UserInputType.MouseButton1
            or i.UserInputType==Enum.UserInputType.Touch then
                dragging=true
                Tween(kn,{Size=UDim2.new(0,20,0,20)},0.1)
                updateVal(i.Position.X)
            end
        end)
        UserInputService.InputChanged:Connect(function(i)
            if not dragging then return end
            if i.UserInputType==Enum.UserInputType.MouseMovement
            or i.UserInputType==Enum.UserInputType.Touch then
                updateVal(i.Position.X)
            end
        end)
        UserInputService.InputEnded:Connect(function(i)
            if(i.UserInputType==Enum.UserInputType.MouseButton1
            or i.UserInputType==Enum.UserInputType.Touch) and dragging then
                dragging=false
                Tween(kn,{Size=UDim2.new(0,16,0,16)},0.1)
            end
        end)
        card.MouseEnter:Connect(function()
            Tween(card,{BackgroundColor3=Theme.SurfaceHover},0.15)
        end)
        card.MouseLeave:Connect(function()
            Tween(card,{BackgroundColor3=Theme.Surface},0.15)
        end)

        local obj={}
        function obj:Set(v)
            value=math.clamp(v,min,max)
            local p=(value-min)/(max-min)
            Tween(fill,{Size=UDim2.new(p,0,1,0)},0.2)
            Tween(kn,  {Position=UDim2.new(p,-8,0.5,-8)},0.2)
            valLbl.Text=tostring(value)..suffix
        end
        function obj:Get() return value end
        return obj
    end

    -- ═══════════════════════════════════════
    --   DROPDOWN — Fixed: panel pakai
    --   ScrollingFrame agar bisa discroll,
