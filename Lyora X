                TextTruncate = Enum.TextTruncate.AtEnd,
                Parent = DropFrame,
            })

            local ValDisplay = Create("TextLabel", {
                Size = UDim2.new(0.58, -44, 0, RowH),
                Position = UDim2.new(0.42, 0, 0, 0),
                BackgroundTransparency = 1,
                Text = "",
                TextColor3 = Y2K.NeonSoft,
                TextSize = UIScale.SmallFontSize,
                Font = FontBody,
                TextXAlignment = Enum.TextXAlignment.Right,
                TextTruncate = Enum.TextTruncate.AtEnd,
                Parent = DropFrame,
            })

            local Arrow = Create("TextLabel", {
                Size = UDim2.new(0, 24, 0, RowH),
                Position = UDim2.new(1, -32, 0, 0),
                BackgroundTransparency = 1,
                Text = "▼",
                TextColor3 = Y2K.NeonSoft,
                TextSize = 11,
                Font = FontBold,
                Parent = DropFrame,
            })

            local TriggerBtn = Create("TextButton", {
                Size = UDim2.new(1, 0, 0, RowH),
                BackgroundTransparency = 1,
                Text = "",
                Parent = DropFrame,
            })

            local ListHolder = Create("ScrollingFrame", {
                Size = UDim2.new(1, -20, 0, 0),
                Position = UDim2.new(0, 10, 0, RowH + 4),
                BackgroundTransparency = 1,
                BorderSizePixel = 0,
                ScrollBarThickness = 3,
                ScrollBarImageColor3 = Y2K.Neon,
                AutomaticCanvasSize = Enum.AutomaticSize.Y,
                CanvasSize = UDim2.new(0, 0, 0, 0),
                Parent = DropFrame,
            })
            Create("UIListLayout", {
                Padding = UDim.new(0, OptPad),
                SortOrder = Enum.SortOrder.LayoutOrder,
                Parent = ListHolder,
            })

            local function DisplayText()
                if Multi then
                    if #Selected == 0 then return "None" end
                    return table.concat(Selected, ", ")
                end
                return tostring(Selected)
            end

            local function ListHeight(n)
                local vis = math.min(n, UIScale.MaxDropdownVisible)
                if vis <= 0 then return 0 end
                return vis * OptH + (vis - 1) * OptPad
            end

            local function ApplyHeight(animate)
                local listH = ListHeight(#CurrentOptions)
                ListHolder.Size = UDim2.new(1, -20, 0, listH)
                local h = IsExpanded and (RowH + 4 + listH + 8) or RowH
                if animate then
                    TweenService:Create(DropFrame, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {
                        Size = UDim2.new(1, 0, 0, h)
                    }):Play()
                else
                    DropFrame.Size = UDim2.new(1, 0, 0, h)
                end
                Arrow.Text = IsExpanded and "▲" or "▼"
            end

            local function IsSelected(opt)
                if Multi then return table.find(Selected, opt) ~= nil end
                return Selected == opt
            end

            local function UpdateHighlights()
                for opt, btn in pairs(OptButtons) do
                    local sel = IsSelected(opt)
                    TweenService:Create(btn, TweenInfo.new(0.12), {
                        BackgroundColor3 = sel and Y2K.NeonDim or Y2K.BgDeep,
                        TextColor3 = sel and Y2K.Chrome or Y2K.Text,
                    }):Play()
                end
            end

            local function SetDropdownValue(val)
                if Multi then
                    local new = {}
                    if type(val) == "table" then
                        for _, v in ipairs(val) do table.insert(new, v) end
                    end
                    Selected = new
                else
                    Selected = val
                end
                ValDisplay.Text = DisplayText()
                SetFlag(Flag, Selected)
                UpdateHighlights()
                task.spawn(Callback, Selected)
            end

            local function BuildOptions(NewOptions)
                for _, child in ipairs(ListHolder:GetChildren()) do
                    if child:IsA("TextButton") then child:Destroy() end
                end
                OptButtons = {}
                CurrentOptions = NewOptions

                local needScroll = #NewOptions > UIScale.MaxDropdownVisible
                for i, opt in ipairs(NewOptions) do
                    local OptBtn = Create("TextButton", {
                        Size = UDim2.new(1, needScroll and -8 or 0, 0, OptH),
                        BackgroundColor3 = Y2K.BgDeep,
                        Text = tostring(opt),
                        TextColor3 = Y2K.Text,
                        TextSize = UIScale.ElementFontSize,
                        Font = FontBody,
                        TextXAlignment = Enum.TextXAlignment.Left,
                        TextTruncate = Enum.TextTruncate.AtEnd,
                        AutoButtonColor = false,
                        LayoutOrder = i,
                        Parent = ListHolder,
                    })
                    AddCorner(OptBtn, 6)
                    Create("UIPadding", {PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 8), Parent = OptBtn})
                    OptButtons[opt] = OptBtn

                    OptBtn.MouseEnter:Connect(function()
                        if IsSelected(opt) then return end
                        TweenService:Create(OptBtn, TweenInfo.new(0.1), {BackgroundColor3 = Y2K.Track}):Play()
                    end)
                    OptBtn.MouseLeave:Connect(function()
                        if IsSelected(opt) then return end
                        TweenService:Create(OptBtn, TweenInfo.new(0.1), {BackgroundColor3 = Y2K.BgDeep}):Play()
                    end)

                    OptBtn.MouseButton1Click:Connect(function()
                        if Multi then
                            local new = {}
                            for _, v in ipairs(Selected) do table.insert(new, v) end
                            local idx = table.find(new, opt)
                            if idx then table.remove(new, idx) else table.insert(new, opt) end
                            SetDropdownValue(new)
                        else
                            SetDropdownValue(opt)
                            IsExpanded = false
                            ApplyHeight(true)
                        end
                    end)
                end
                UpdateHighlights()
            end

            local function RefreshOptions(NewOptions)
                BuildOptions(NewOptions)
                if Multi then
                    local filtered, changed = {}, false
                    for _, v in ipairs(Selected) do
                        if table.find(NewOptions, v) then table.insert(filtered, v) else changed = true end
                    end
                    if changed then SetDropdownValue(filtered) end
                else
                    if not table.find(NewOptions, Selected) and NewOptions[1] ~= nil then
                        SetDropdownValue(NewOptions[1])
                    end
                end
                ApplyHeight(true)
            end

            ValDisplay.Text = DisplayText()
            BuildOptions(Options)
            ApplyHeight(false)

            TriggerBtn.MouseButton1Click:Connect(function()
                IsExpanded = not IsExpanded
                ApplyHeight(true)
            end)

            if Flag then LunoLibrary.Elements[Flag] = { Set = SetDropdownValue } end

            return { Refresh = RefreshOptions, Set = SetDropdownValue }
        end

