    local SelectedConfigName = ""
    local ConfigDropdownObj2

    local function GetSavedConfigNames()
        local list = {}
        pcall(function()
            for _, file in ipairs(SafeListFiles("LunoConfigs")) do
                local clean = tostring(file):match("([^/\\]+)%.json$")
                if clean then table.insert(list, clean) end
            end
        end)
        return #list > 0 and list or {"No Saved Configs"}
    end

    SelectedConfigName = GetSavedConfigNames()[1] or ""

    ConfigTab:CreateInput({
        Title       = "Custom Config Name",
        Placeholder = "Type config name...",
        Callback    = function(Text) TypedConfigName = Text end
    })

    ConfigTab:CreateButton({
        Title    = "Save Config (Using Name Above)",
        Callback = function()
            local saveName = (#TypedConfigName > 0) and TypedConfigName or "default_config"
            saveName = saveName:gsub("[^%w_%-%s]", "")
            if saveName == "" then saveName = "default_config" end
            SafeMakeFolder("LunoConfigs")
            SafeWriteFile(
                "LunoConfigs/" .. saveName .. ".json",
                HttpService:JSONEncode(LunoLibrary.Flags)
            )
            SelectedConfigName = saveName
            LunoLibrary:Notify({Title = "Config Saved", Content = "Saved as: " .. saveName, Duration = 3})
            if ConfigDropdownObj2 then
                ConfigDropdownObj2.Refresh(GetSavedConfigNames())
                ConfigDropdownObj2.Set(saveName)
            end
        end
    })

    ConfigTab:CreateSection("Load & Delete Manager", {Box = true})

    ConfigDropdownObj2 = ConfigTab:CreateDropdown({
        Title    = "Select Saved Config",
        Options  = GetSavedConfigNames(),
        Multi    = false,
        Flag     = false,
        Callback = function(Sel)
            if Sel and Sel ~= "No Saved Configs" then
                SelectedConfigName = Sel
            end
        end
    })

    ConfigTab:CreateButton({
        Title    = "Load Selected Config",
        Callback = function()
            local target = SelectedConfigName
            if not target or target == "" or target == "No Saved Configs" then
                target = GetSavedConfigNames()[1] or ""
            end
            if target == "" or target == "No Saved Configs" then
                LunoLibrary:Notify({Title = "Error", Content = "No valid config!", Duration = 3})
                return
            end
            local content = SafeReadFile("LunoConfigs/" .. target .. ".json")
            if not content then
                LunoLibrary:Notify({Title = "Error", Content = "File not found: " .. target, Duration = 3})
                return
            end
            local ok, data = pcall(function() return HttpService:JSONDecode(content) end)
            if ok and type(data) == "table" then
                for flag, val in pairs(data) do
                    LunoLibrary.Flags[flag] = val
                    if LunoLibrary.Elements[flag] and LunoLibrary.Elements[flag].Set then
                        pcall(LunoLibrary.Elements[flag].Set, val)
                    end
                end
                LunoLibrary:Notify({Title = "Config Loaded", Content = "Loaded: " .. target, Duration = 3})
            else
                LunoLibrary:Notify({Title = "Error", Content = "Corrupted config!", Duration = 3})
            end
        end
    })

    ConfigTab:CreateButton({
        Title    = "Delete Selected Config",
        Callback = function()
            if SelectedConfigName ~= "" and SelectedConfigName ~= "No Saved Configs" then
                SafeDeleteFile("LunoConfigs/" .. SelectedConfigName .. ".json")
                LunoLibrary:Notify({Title = "Deleted", Content = "Deleted: " .. SelectedConfigName, Duration = 3})
                local nl = GetSavedConfigNames()
                SelectedConfigName = nl[1] or ""
                if ConfigDropdownObj2 then ConfigDropdownObj2.Refresh(nl) end
            end
        end
    })

    ConfigTab:CreateButton({
        Title    = "Refresh Config List",
        Callback = function()
            if ConfigDropdownObj2 then
                ConfigDropdownObj2.Refresh(GetSavedConfigNames())
                LunoLibrary:Notify({Title = "Refreshed", Content = "Config list updated!", Duration = 2})
            end
        end
    })

    -- ══════════════════════════════════════════════════════
    -- HIDDEN PROFILE PAGE
    -- ══════════════════════════════════════════════════════
    local ProfilePage = Create("Frame", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Visible = false,
        Parent = ContentContainer,
    })

    local ProfileTabObj = { Holder = nil, Page = ProfilePage, Hidden = true }
    Tabs["__UserProfile__"] = ProfileTabObj

    UserCard.MouseButton1Click:Connect(function()
        SwitchTab(ProfileTabObj)
    end)

    local ProfileScroll2 = Create("ScrollingFrame", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = Y2K.Neon,
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        Parent = ProfilePage,
    })
    Create("UIPadding", {
        PaddingLeft = UDim.new(0, 4),
        PaddingRight = UDim.new(0, 10),
        PaddingTop = UDim.new(0, 2),
        PaddingBottom = UDim.new(0, 10),
        Parent = ProfileScroll2,
    })
    Create("UIListLayout", {
        Padding = UDim.new(0, 6),
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = ProfileScroll2,
    })

    local ProfileOrder = 0
    local function CreateProfileItem(Text, CB)
        ProfileOrder = ProfileOrder + 1
        local PBtn = Create("TextButton", {
            Size = UDim2.new(1, 0, 0, UIScale.RowHeight),
            BackgroundColor3 = Y2K.BgInput,
            Text = Text,
            TextColor3 = Y2K.Text,
            TextSize = UIScale.ElementFontSize,
            Font = FontBody,
            TextTruncate = Enum.TextTruncate.AtEnd,
            AutoButtonColor = false,
            LayoutOrder = ProfileOrder,
            Parent = ProfileScroll2,
        })
        AddCorner(PBtn, 8)
        Create("UIPadding", {PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 14), Parent = PBtn})
        PBtn.TextXAlignment = Enum.TextXAlignment.Left
        local pStroke = AddChromeStroke(PBtn, 1, 0.6)
        AddHoverGlow(PBtn, pStroke)

        if CB then PBtn.MouseButton1Click:Connect(function() task.spawn(CB) end) end
    end

    local function CopyNotify(label, value)
        RealSetClipboard(value)
        LunoLibrary:Notify({Title = "Copied", Content = label .. " copied to clipboard.", Duration = 2})
    end

    local function ServerHop(order, needPlayers)
        pcall(function()
            local req = game:HttpGet(
                "https://games.roblox.com/v1/games/" .. game.PlaceId
                .. "/servers/0?sortOrder=" .. order .. "&limit=100"
            )
            local body = HttpService:JSONDecode(req)
            if body and body.data then
                for _, s in ipairs(body.data) do
                    if s.id ~= game.JobId
                    and s.playing < s.maxPlayers
                    and (not needPlayers or s.playing > 0) then
                        LunoLibrary:Notify({Title = "Server Hop", Content = "Teleporting...", Duration = 2})
                        TeleportService:TeleportToPlaceInstance(game.PlaceId, s.id, LocalPlayer)
                        return
                    end
                end
            end
            LunoLibrary:Notify({Title = "Server Hop", Content = "No server found.", Duration = 3})
        end)
    end

    CreateProfileItem("Username: " .. LocalPlayer.Name, function()
        CopyNotify("Username", LocalPlayer.Name)
    end)
    CreateProfileItem("User ID: " .. tostring(LocalPlayer.UserId), function()
        CopyNotify("User ID", tostring(LocalPlayer.UserId))
    end)
    CreateProfileItem("Game: " .. CurrentGameName, nil)
    CreateProfileItem("Job ID: " .. tostring(game.JobId), function()
        CopyNotify("Job ID", tostring(game.JobId))
    end)
    CreateProfileItem("Rejoin Server", function()
        pcall(function()
            TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
        end)
    end)
    CreateProfileItem("Server Hop (Random)", function()
        ServerHop("Desc", false)
    end)
    CreateProfileItem("Small Server Hop (Lowest Players)", function()
        ServerHop("Asc", true)
    end)

    -- Default tab (digantikan otomatis oleh tab user pertama)
    SwitchTab(Tabs["MISC"])

    -- ══════════════════════════════════════════════════════
    -- AUTO DEVICE DETECTION NOTIFICATION
    -- ══════════════════════════════════════════════════════
    task.delay(0.6, function()
        if not MainScreenGui or not MainScreenGui.Parent then return end

        if DeviceType == "PC" then
            LunoLibrary:Notify({
                Title    = "PC / Laptop Detected",
                Content  = "Press " .. ToggleKeyName .. " to hide / show the menu.",
                Duration = 6,
            })
        elseif DeviceType == "Tablet" then
            LunoLibrary:Notify({
                Title    = "Tablet Detected",
                Content  = "Tap the LUNO floating button to hide / show the menu.",
                Duration = 6,
            })
        else
            LunoLibrary:Notify({
                Title    = "Mobile Detected",
                Content  = "Tap the LUNO floating button to hide / show the menu.",
                Duration = 6,
            })
        end
    end)

    return LunoLibrary
end

return LunoLibrary
