            local function FilterCards()
                local text = string.lower(SearchBox.Text)
                for _, item in ipairs(CardsList) do
                    local match = string.find(string.lower(item.Title), text) or string.find(string.lower(item.Category), text)
                    item.CardFrame.Visible = match ~= nil
                end
                ScrollList.CanvasSize = UDim2.new(0, 0, 0, CardsLayout.AbsoluteContentSize.Y + 10)
            end

            SearchBox:GetPropertyChangedSignal("Text"):Connect(FilterCards)

            local ScriptListObj = {}
            function ScriptListObj:AddCard(CardData)
