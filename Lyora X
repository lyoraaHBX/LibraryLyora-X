        setclipboard(tostring(LocalPlayer.UserId))
    end)

    ProfileTab:CreateButton("🎮 Place ID: " .. tostring(game.PlaceId), function()
        setclipboard(tostring(game.PlaceId))
    end)

    ProfileTab:CreateButton("🔑 Room ID (Job ID): " .. tostring(game.JobId), function()
        setclipboard(tostring(game.JobId))
    end)

    -- Rejoin Server
    ProfileTab:CreateButton("🔄 Rejoin Server", function()
        TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
    end)

    -- Server Hop (Random Public Server)
    ProfileTab:CreateButton("🔀 Server Hop (Random)", function()
        pcall(function()
            local req = game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/0?sortOrder=Desc&limit=100")
            local body = HttpService:JSONDecode(req)
            if body and body.data then
                for _, s in ipairs(body.data) do
                    if s.id ~= game.JobId and s.playing < s.maxPlayers then
                        TeleportService:TeleportToPlaceInstance(game.PlaceId, s.id, LocalPlayer)
                        break
                    end
                end
            end
        end)
    end)

    -- Small Server Hop (Lowest Players)
    ProfileTab:CreateButton("📉 Small Server Hop (Lowest Players)", function()
        pcall(function()
            local req = game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/0?sortOrder=Asc&limit=100")
            local body = HttpService:JSONDecode(req)
            if body and body.data then
                for _, s in ipairs(body.data) do
                    if s.id ~= game.JobId and s.playing > 0 and s.playing < s.maxPlayers then
                        TeleportService:TeleportToPlaceInstance(game.PlaceId, s.id, LocalPlayer)
                        break
                    end
                end
            end
        end)
    end)

    return LunoLibrary
end

