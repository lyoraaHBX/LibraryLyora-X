        Tween(iconLbl,{TextColor3=Theme.AccentGlow},0.2)
        Tween(nameLbl,{TextColor3=Theme.TextPrimary},0.2)
        self.ActiveTab=Tab
    end

    Tab.Select=activateThis
    btn.MouseButton1Click:Connect(activateThis)
    btn.MouseEnter:Connect(function()
        if self.ActiveTab~=Tab then Tween(btn,{BackgroundTransparency=0.25},0.15) end
    end)
    btn.MouseLeave:Connect(function()
        if self.ActiveTab~=Tab then Tween(btn,{BackgroundTransparency=0.5},0.15) end
    end)
    table.insert(self.Tabs,Tab)
    if #self.Tabs==1 then activateThis() end

