            for _, file in ipairs(files) do
                if file:sub(-5) == ".json" then
                    local clean = file
                        :gsub("LunoConfigs\\", "")
                        :gsub("LunoConfigs/", "")
                        :gsub("%.json", "")
                    table.insert(list, clean)
                end
            end
        end)
