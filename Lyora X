local function ClampToScreen(pos, size)
    local vp = Camera.ViewportSize
    local minX, minY = -size.X + 80, 0
    local maxX, maxY = vp.X - 80, vp.Y - 40
    return UDim2.new(0, math.clamp(pos.X, minX, maxX), 0, math.clamp(pos.Y, minY, maxY))
end

getgenv().LunoUI_Cleanup = function()
    for _, fn in ipairs(CleanupTasks) do pcall(fn) end
    for _, conn in ipairs(ActiveConnections) do pcall(function() conn:Disconnect() end) end
    for plr, data in pairs(ESPObjects) do
        if data.Highlight then pcall(function() data.Highlight:Destroy() end) end
        if data.Billboard then pcall(function() data.Billboard:Destroy() end) end
    end
    ESPObjects = {}
    ThemeRegistry = {}
    if MainScreenGui and MainScreenGui.Parent then MainScreenGui:Destroy() end
    getgenv().LunoUI_Cleanup = nil
end

