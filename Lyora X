        local selected = default
        local isOpen   = false

        -- wrap: tidak clip, tidak expand tinggi (dropdown panel akan float)
        local wrap=Create("Frame",{
            Size=UDim2.new(1,-10,0,44),
            BackgroundTransparency=1,
            ClipsDescendants=false,
            ZIndex=8, Parent=page,
