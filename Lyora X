                Rotation = 0,
                Parent = Holder,
            })
            HolderStroke = AddChromeStroke(Holder, 1, 1)

            local textPadLeft = 16
            if IconId then
                Create("ImageLabel", {
                    Size = UDim2.new(0, 18, 0, 18),
                    Position = UDim2.new(0, 14, 0.5, -9),
