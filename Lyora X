                    Image = IconId,
                    ImageColor3 = Y2K.TextDim,
                    Parent = Holder,
                })
                textPadLeft = 40
            end

            TabButton = Create("TextButton", {
                Size = UDim2.new(1, 0, 1, 0),
                BackgroundTransparency = 1,
                Text = TabName,
                TextColor3 = Y2K.TextDim,
                TextSize = UIScale.TabFontSize,
                Font = FontBold,
                TextXAlignment = Enum.TextXAlignment.Left,
                AutoButtonColor = false,
                Parent = Holder,
            })
            Create("UIPadding", {PaddingLeft = UDim.new(0, textPadLeft), Parent = TabButton})
        end

        local TabPage = Create("Frame", {
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1,
            Visible = false,
            Parent = ContentContainer,
        })

        local PendingQueue = {}
        local TabObj = {
            Holder = Holder,
            Label  = TabButton,
            Stroke = HolderStroke,
            Page   = TabPage,
            Hidden = IsHidden or false,
            Loaded = false,
        }
        function TabObj.Flush()
            if TabObj.Loaded then return end
            TabObj.Loaded = true
            local q = PendingQueue
            PendingQueue = {}
            for _, fn in ipairs(q) do pcall(fn) end
        end

        local function QueueOrRun(fn)
            if TabObj.Loaded then fn()
            else table.insert(PendingQueue, fn) end
        end

        Tabs[TabName] = TabObj

        if TabButton then
            TabButton.MouseEnter:Connect(function()
                if ActiveTab == TabObj then return end
                TweenService:Create(Holder, TweenInfo.new(0.15), {BackgroundTransparency = 0.85}):Play()
                TweenService:Create(TabButton, TweenInfo.new(0.15), {TextColor3 = Y2K.NeonSoft}):Play()
