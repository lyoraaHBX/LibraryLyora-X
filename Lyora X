        function TabElements:CreateDropdown(Opts)
            Opts = Opts or {}
            local Name     = Opts.Title or Opts.Name or "Dropdown"
            local Options  = Opts.Options or {"Option 1"}
            local Multi    = Opts.Multi or false
            local Flag     = Opts.Flag; if Flag == nil then Flag = Name end
            local Callback = Opts.Callback or function() end
            local boxed    = InsideBox
            local RowH     = UIScale.RowHeight
            local OptH     = UIScale.OptionHeight
            local OptPad   = 2
            local Deferred = NewDeferred()

            QueueOrRun(function()
                local Selected
                if Multi then
                    Selected = {}
                    if type(Opts.Default) == "table" then
                        for _, v in ipairs(Opts.Default) do table.insert(Selected, v) end
                    end
                else
                    Selected = Opts.Default or Options[1]
                end

                local CurrentOptions = {}
                for _, v in ipairs(Options) do table.insert(CurrentOptions, v) end
                local OptButtons  = {}
                local IsExpanded  = false
                local FollowConn  = nil

                SetFlag(Flag, Selected)

                local DropFrame = Create("Frame", {
                    Size = UDim2.new(1, 0, 0, RowH),
                    ThemeBackground = "BgInput",
                    ClipsDescendants = true,
                    LayoutOrder = PrepareRow(),
                    Parent = CurrentContainer,
                })
                StyleRow(DropFrame, boxed)

                Create("TextLabel", {
                    Size = UDim2.new(0.42, -14, 0, RowH),
                    Position = UDim2.new(0, 14, 0, 0),
                    BackgroundTransparency = 1,
                    Text = Name,
                    ThemeText = "Text",
                    TextSize = UIScale.ElementFontSize,
                    Font = FontBody,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    TextTruncate = Enum.TextTruncate.AtEnd,
                    Parent = DropFrame,
                })

                local ValDisplay = Create("TextLabel", {
                    Size = UDim2.new(0.58, -44, 0, RowH),
                    Position = UDim2.new(0.42, 0, 0, 0),
                    BackgroundTransparency = 1,
                    Text = "",
                    ThemeText = "NeonSoft",
                    TextSize = UIScale.SmallFontSize,
                    Font = FontBody,
                    TextXAlignment = Enum.TextXAlignment.Right,
                    TextTruncate = Enum.TextTruncate.AtEnd,
                    Parent = DropFrame,
                })

                local Arrow = Create("TextLabel", {
                    Size = UDim2.new(0, 24, 0, RowH),
                    Position = UDim2.new(1, -32, 0, 0),
                    BackgroundTransparency = 1,
                    Text = "▼",
                    ThemeText = "NeonSoft",
                    TextSize = 11,
                    Font = FontBold,
                    Parent = DropFrame,
                })

                local TriggerBtn = Create("TextButton", {
                    Size = UDim2.new(1, 0, 0, RowH),
                    BackgroundTransparency = 1,
                    Text = "",
                    Parent = DropFrame,
                })

                -- FIX: ZIndex ListHolder 1002 (di atas OverlayLayer 1000)
                local ListHolder = Create("ScrollingFrame", {
                    Size = UDim2.new(0, 200, 0, 0),
                    ThemeBackground = "BgPanel2",
                    BorderSizePixel = 0,
                    ScrollBarThickness = 3,
                    ScrollBarImageColor3 = Y2K.Neon,
                    AutomaticCanvasSize = Enum.AutomaticSize.Y,
                    CanvasSize = UDim2.new(0, 0, 0, 0),
                    ClipsDescendants = true,
                    Visible = false,
                    ZIndex = 1002,
                    Parent = OverlayLayer,
                })
                AddCorner(ListHolder, 8)
                AddChromeStroke(ListHolder, 1.2, 0.3)
                Create("UIPadding", {
                    PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4),
                    PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 4),
                    Parent = ListHolder,
                })
                Create("UIListLayout", {
                    Padding = UDim.new(0, OptPad),
                    SortOrder = Enum.SortOrder.LayoutOrder,
                    Parent = ListHolder,
                })

                local function DisplayText()
                    if Multi then
                        if #Selected == 0 then return "None" end
                        return table.concat(Selected, ", ")
                    end
                    return tostring(Selected)
                end

                local function ListHeight(n)
                    local vis = math.min(n, UIScale.MaxDropdownVisible)
                    if vis <= 0 then return 8 end
                    return vis * OptH + math.max(vis - 1, 0) * OptPad + 8
                end

                local function IsSelected(opt)
                    if Multi then return table.find(Selected, opt) ~= nil end
                    return Selected == opt
                end

                local function UpdateHighlights()
                    for opt, btn in pairs(OptButtons) do
                        local sel = IsSelected(opt)
                        TweenService:Create(btn, TweenInfo.new(0.12), {
                            -- FIX: gunakan NeonDim untuk selected, bukan Neon/biru terang
                            BackgroundColor3 = sel and Y2K.NeonDim or Y2K.BgDeep,
                            TextColor3 = sel and Y2K.Chrome or Y2K.Text,
                        }):Play()
                    end
                end

                local function SetDropdownValue(val)
                    if Multi then
                        local new = {}
                        if type(val) == "table" then
                            for _, v in ipairs(val) do table.insert(new, v) end
                        end
                        Selected = new
                    else
                        Selected = val
                    end
                    ValDisplay.Text = DisplayText()
                    SetFlag(Flag, Selected)
                    UpdateHighlights()
                    task.spawn(Callback, Selected)
                end

                -- FIX: Kalkulasi posisi dropdown yang benar
                -- Prioritas: buka ke BAWAH dulu, kalau tidak muat baru ke atas
                local function PositionList()
                    local vp = Camera.ViewportSize
                    local listH = ListHeight(#CurrentOptions)
                    local listW = math.max(DropFrame.AbsoluteSize.X, 180)

                    -- Gunakan AbsolutePosition dari DropFrame (koordinat screen)
                    local frameAbsPos  = DropFrame.AbsolutePosition
                    local frameAbsSize = DropFrame.AbsoluteSize

                    -- Coba posisi di bawah frame
                    local yBelow = frameAbsPos.Y + frameAbsSize.Y + 4
                    local yAbove = frameAbsPos.Y - listH - 4

                    local finalY
                    if yBelow + listH <= vp.Y - 4 then
                        -- Ada cukup ruang di bawah
                        finalY = yBelow
                    elseif yAbove >= 4 then
                        -- Tidak muat di bawah, pakai atas
                        finalY = yAbove
                    else
                        -- Paksa ke bawah kalau kedua tidak ideal
                        finalY = yBelow
                    end

                    -- Clamp X agar tidak keluar layar
                    local finalX = math.clamp(frameAbsPos.X, 4, math.max(vp.X - listW - 4, 4))

                    ListHolder.Position = UDim2.new(0, finalX, 0, finalY)
                    ListHolder.Size = UDim2.new(0, listW, 0, listH)
                end

                local Blocker
                local function CloseDropdown()
                    IsExpanded = false
                    ListHolder.Visible = false
                    Arrow.Text = "▼"
                    if Blocker then Blocker:Destroy(); Blocker = nil end
                    if FollowConn then FollowConn:Disconnect(); FollowConn = nil end
                end

                local function OpenDropdown()
                    CloseAllOverlays()
                    IsExpanded = true
                    PositionList()
                    ListHolder.Visible = true
                    Arrow.Text = "▲"

                    -- FIX: Blocker ZIndex 1001 (antara OverlayLayer 1000 dan ListHolder 1002)
                    Blocker = Create("TextButton", {
                        Size = UDim2.new(1, 0, 1, 0),
                        BackgroundTransparency = 1,
                        Text = "",
                        ZIndex = 1001,
                        Parent = OverlayLayer,
                    })
                    Blocker.MouseButton1Click:Connect(CloseDropdown)
                    FollowConn = RegisterConnection(RunService.RenderStepped:Connect(PositionList))
                    table.insert(ActiveOverlayClosers, CloseDropdown)
                end

                local function BuildOptions(NewOptions)
                    for opt, btn in pairs(OptButtons) do
                        local stillExists = false
                        for _, o in ipairs(NewOptions) do
                            if o == opt then stillExists = true break end
                        end
                        if not stillExists then
                            btn:Destroy()
                            OptButtons[opt] = nil
                        end
                    end
                    CurrentOptions = {}
                    for _, v in ipairs(NewOptions) do table.insert(CurrentOptions, v) end

                    for i, opt in ipairs(NewOptions) do
                        local btn = OptButtons[opt]
                        if not btn then
                            btn = Create("TextButton", {
                                Size = UDim2.new(1, 0, 0, OptH),
                                BackgroundColor3 = Y2K.BgDeep,
                                Text = tostring(opt),
                                TextColor3 = Y2K.Text,
                                TextSize = UIScale.ElementFontSize,
                                Font = FontBody,
                                TextXAlignment = Enum.TextXAlignment.Left,
                                TextTruncate = Enum.TextTruncate.AtEnd,
                                AutoButtonColor = false,
                                ZIndex = 1003,
                                Parent = ListHolder,
                            })
                            AddCorner(btn, 6)
                            Create("UIPadding", {
                                PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 8),
                                Parent = btn,
                            })
                            btn.MouseEnter:Connect(function()
                                if not IsSelected(opt) then
                                    TweenService:Create(btn, TweenInfo.new(0.1), {BackgroundColor3 = Y2K.Track}):Play()
                                end
                            end)
                            btn.MouseLeave:Connect(function()
                                if not IsSelected(opt) then
                                    TweenService:Create(btn, TweenInfo.new(0.1), {BackgroundColor3 = Y2K.BgDeep}):Play()
                                end
                            end)
                            btn.MouseButton1Click:Connect(function()
                                if Multi then
                                    local new = {}
                                    for _, v in ipairs(Selected) do table.insert(new, v) end
                                    local idx = table.find(new, opt)
                                    if idx then table.remove(new, idx) else table.insert(new, opt) end
                                    SetDropdownValue(new)
                                else
                                    SetDropdownValue(opt)
                                    CloseDropdown()
                                end
                            end)
                            OptButtons[opt] = btn
                        end
                        btn.LayoutOrder = i
                        btn.Text = tostring(opt)
                    end
                    UpdateHighlights()
                end

                local function RefreshOptions(NewOptions)
                    BuildOptions(NewOptions)
                    if Multi then
                        local filtered, changed = {}, false
                        for _, v in ipairs(Selected) do
                            if table.find(NewOptions, v) then table.insert(filtered, v) else changed = true end
                        end
                        if changed then SetDropdownValue(filtered) end
                    else
                        local found = false
                        for _, o in ipairs(NewOptions) do if o == Selected then found = true break end end
                        if not found and NewOptions[1] ~= nil then SetDropdownValue(NewOptions[1]) end
                    end
                    if IsExpanded then PositionList() end
                end

                ValDisplay.Text = DisplayText()
                BuildOptions(Options)

                TriggerBtn.MouseButton1Click:Connect(function()
                    if IsExpanded then CloseDropdown() else OpenDropdown() end
                end)

                local Obj = WrapElement(DropFrame, Flag, SetDropdownValue, {
                    Refresh = function(self, opts) RefreshOptions(opts) end
                })
                local origDestroy = Obj.Destroy
                Obj.Destroy = function(self)
                    CloseDropdown()
                    pcall(function() ListHolder:Destroy() end)
                    origDestroy(self)
                end

                if Flag then LunoLibrary.Elements[Flag] = Obj end
                Deferred._bind(Obj)
            end)
            return Deferred
        end

