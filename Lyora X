        pcall(function()
            local char = LocalPlayer.Character
            if not char then return end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChildOfClass("Humanoid")
            if not hrp or not hum then return end
            hum.PlatformStand = true

            local bv = hrp:FindFirstChild("LunoFlyBV")
            if not bv then
                bv = Instance.new("BodyVelocity")
                bv.Name = "LunoFlyBV"
                bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
                bv.Velocity = Vector3.zero
                bv.Parent = hrp
            end

            local bg = hrp:FindFirstChild("LunoFlyBG")
            if not bg then
                bg = Instance.new("BodyGyro")
                bg.Name = "LunoFlyBG"
                bg.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
                bg.P = 9e4
                bg.Parent = hrp
            end

            local camCF = Camera.CFrame
            bg.CFrame = camCF

            local moveVec = Vector3.zero
            local md = hum.MoveDirection
            if md.Magnitude > 0 then
                local flatF = Vector3.new(camCF.LookVector.X, 0, camCF.LookVector.Z)
                local flatR = Vector3.new(camCF.RightVector.X, 0, camCF.RightVector.Z)
                if flatF.Magnitude > 0.001 and flatR.Magnitude > 0.001 then
                    moveVec = camCF.LookVector * md:Dot(flatF.Unit) + camCF.RightVector * md:Dot(flatR.Unit)
                end
            end

            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
                moveVec = moveVec + Vector3.new(0, 1, 0)
            elseif UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.E) then
                moveVec = moveVec + Vector3.new(0, 0.5, 0)
            elseif UserInputService:IsKeyDown(Enum.KeyCode.Q) then
                moveVec = moveVec - Vector3.new(0, 0.5, 0)
            end

            bv.Velocity = (moveVec.Magnitude > 0) and moveVec.Unit * FlySpeed or Vector3.zero
        end)
    end))

