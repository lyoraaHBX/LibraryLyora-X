                if hum then hum.PlatformStand = false end
            end
        end)
    end

    -- FIX #6: Pisahkan logika fly ke connection sendiri,
    -- hindari memanggil StopFlying() setiap frame
    local FlyConnection = nil

    local function StartFlyLoop()
        if FlyConnection then return end
        FlyConnection = RunService.RenderStepped:Connect(function()
            if not Flying then return end  -- early return, tidak destroy
            pcall(function()
                local char = LocalPlayer.Character
                if not char then return end
                local hrp = char:FindFirstChild("HumanoidRootPart")
                local hum = char:FindFirstChildOfClass("Humanoid")
                if not hrp or not hum then return end

                hum.PlatformStand = true

                local bv = hrp:FindFirstChild("LunoFlyBV")
                if not bv then
                    bv = Instance.new("BodyVelocity")
                    bv.Name     = "LunoFlyBV"
                    bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
                    bv.Parent   = hrp
                end

                local bg = hrp:FindFirstChild("LunoFlyBG")
                if not bg then
                    bg = Instance.new("BodyGyro")
                    bg.Name     = "LunoFlyBG"
                    bg.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
                    bg.P        = 9e4
                    bg.Parent   = hrp
                end

                bg.CFrame = Camera.CFrame

                local camCF  = Camera.CFrame
                local moveVec = Vector3.zero

                if hum.MoveDirection.Magnitude > 0 then
                    local md  = hum.MoveDirection
                    local fwd = Vector3.new(camCF.LookVector.X,  0, camCF.LookVector.Z).Unit
                    local rgt = Vector3.new(camCF.RightVector.X, 0, camCF.RightVector.Z).Unit

                    local df = md:Dot(fwd)
                    local dr = md:Dot(rgt)
                    if df ~= df then df = 0 end  -- NaN check
                    if dr ~= dr then dr = 0 end

                    moveVec = camCF.LookVector * df + camCF.RightVector * dr
                end

                if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
                    moveVec = moveVec + Vector3.new(0, 1, 0)
                elseif UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)
                    or UserInputService:IsKeyDown(Enum.KeyCode.E) then
                    moveVec = moveVec + Vector3.new(0, 0.5, 0)
                elseif UserInputService:IsKeyDown(Enum.KeyCode.Q) then
                    moveVec = moveVec - Vector3.new(0, 0.5, 0)
                end

                bv.Velocity = (moveVec.Magnitude > 0)
                    and moveVec.Unit * FlySpeed
                    or  Vector3.zero
            end)
        end)
        RegisterConnection(FlyConnection)
    end

