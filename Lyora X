    local PlayerDropdownObj

    local function GetPlayerNames()
        local list = {}
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then table.insert(list, p.Name) end
        end
        return #list > 0 and list or {"No Players"}
    end

    PlayerDropdownObj = MiscTab:CreateDropdown({
        Title = "Select Player Target",
        Options = GetPlayerNames(),
        Multi = false,
        Flag = "TeleportTargetPlayer",
        Callback = function(Sel) TargetTeleportPlayer = Sel end
    })

    RegisterConnection(Players.PlayerAdded:Connect(function() PlayerDropdownObj.Refresh(GetPlayerNames()) end))
    RegisterConnection(Players.PlayerRemoving:Connect(function() PlayerDropdownObj.Refresh(GetPlayerNames()) end))

    MiscTab:CreateButton({
        Title = "Instant Teleport to Selected Player",
        Callback = function()
            local targetPlr = Players:FindFirstChild(TargetTeleportPlayer)
            if targetPlr and targetPlr.Character and targetPlr.Character:FindFirstChild("HumanoidRootPart") and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                LocalPlayer.Character.HumanoidRootPart.CFrame = targetPlr.Character.HumanoidRootPart.CFrame
                LunoLibrary:Notify({Title = "Teleport", Content = "Teleported to " .. TargetTeleportPlayer, Duration = 2})
            end
        end
    })

    MiscTab:CreateSection("Utilities & Performance")

    MiscTab:CreateToggle({
        Title = "Anti-AFK Bypass (20-Min Protection)",
        Default = true,
        Flag = "AntiAFKBypass",
        Callback = function(State)
            if State then
                local vu = game:GetService("VirtualUser")
                RegisterConnection(LocalPlayer.Idled:Connect(function()
                    vu:CaptureController() vu:ClickButton2(Vector2.new())
                end))
            end
        end
    })

    MiscTab:CreateButton({
        Title = "🚀 100% Anti-Lag FPS Booster",
        Callback = function()
            pcall(function()
                Lighting.GlobalShadows = false
                Lighting.FogEnd = 9e9
                for _, obj in ipairs(workspace:GetDescendants()) do
                    if obj:IsA("BasePart") then
                        obj.Material = Enum.Material.SmoothPlastic
                    elseif obj:IsA("Decal") or obj:IsA("Texture") then
                        obj:Destroy()
                    elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Smoke") or obj:IsA("Fire") then
                        obj.Enabled = false
                    end
                end
            end)
            LunoLibrary:Notify({Title = "FPS Booster", Content = "Anti-Lag Applied!", Duration = 3})
        end
    })

    ---------------------------------------------------------
    -- AUTOMATICALLY INJECTED "CONFIG" TAB (PINNED BOTTOM ORDER 9999)
    ---------------------------------------------------------
    local ConfigTab = LunoLibrary:CreateTab("Config", 9999)

    ConfigTab:CreateSection("Configuration Manager")

    local TypedConfigName = ""
    local SelectedConfigName = ""
    local ConfigDropdownObj

    local function GetSavedConfigNames()
        local list = {}
        pcall(function()
            local files = SafeListFiles("LunoConfigs")
            for _, file in ipairs(files) do
                if file:sub(-5) == ".json" then
                    local cleanName = file:gsub("LunoConfigs\\", ""):gsub("LunoConfigs/", ""):gsub("%.json", "")
                    table.insert(list, cleanName)
                end
            end
        end)
        return #list > 0 and list or {"No Saved Configs"}
    end

    ConfigTab:CreateInput({
        Title = "Custom Config Name",
        Placeholder = "Type config name...",
        Callback = function(Text)
            TypedConfigName = Text
        end
    })

    -- 100% WORKING CROSS-EXECUTOR CONFIG SAVE LOGIC
    ConfigTab:CreateButton({
        Title = "💾 Save Config (Using Name Above)",
        Callback = function()
            local finalSaveName = (#TypedConfigName > 0) and TypedConfigName or "default_config"
            SafeMakeFolder("LunoConfigs")
            local jsonString = HttpService:JSONEncode(LunoLibrary.Flags)
            SafeWriteFile("LunoConfigs/" .. finalSaveName .. ".json", jsonString)
            
            LunoLibrary:Notify({Title = "Config Saved", Content = "Saved as: " .. finalSaveName, Duration = 3})
            if ConfigDropdownObj then ConfigDropdownObj.Refresh(GetSavedConfigNames()) end
        end
    })

    ConfigTab:CreateSection("Load & Delete Manager")

    ConfigDropdownObj = ConfigTab:CreateDropdown({
        Title = "Select Saved Config",
        Options = GetSavedConfigNames(),
        Multi = false,
        Callback = function(Sel) SelectedConfigName = Sel end
    })

    -- 100% WORKING CROSS-EXECUTOR CONFIG LOAD LOGIC (Updates Visuals & Callbacks)
    ConfigTab:CreateButton({
        Title = "📂 Load Selected Config",
        Callback = function()
            local content = SafeReadFile("LunoConfigs/" .. SelectedConfigName .. ".json")
            if content then
                local success, data = pcall(function() return HttpService:JSONDecode(content) end)
                if success and type(data) == "table" then
                    for flag, val in pairs(data) do
                        LunoLibrary.Flags[flag] = val
                        if LunoLibrary.Elements[flag] and LunoLibrary.Elements[flag].Set then
                            pcall(function() LunoLibrary.Elements[flag].Set(val) end)
                        end
                    end
                    LunoLibrary:Notify({Title = "Config Loaded", Content = "Loaded: " .. SelectedConfigName, Duration = 3})
                else
                    LunoLibrary:Notify({Title = "Error", Content = "Corrupted config file!", Duration = 3})
                end
            else
                LunoLibrary:Notify({Title = "Error", Content = "Config file not found!", Duration = 3})
            end
        end
    })

    ConfigTab:CreateButton({
        Title = "🗑️ Delete Selected Config",
        Callback = function()
            SafeDeleteFile("LunoConfigs/" .. SelectedConfigName .. ".json")
            LunoLibrary:Notify({Title = "Config Deleted", Content = "Deleted: " .. SelectedConfigName, Duration = 3})
            if ConfigDropdownObj then ConfigDropdownObj.Refresh(GetSavedConfigNames()) end
        end
    })

    ConfigTab:CreateButton({
        Title = "🔄 Refresh Config List",
        Callback = function()
            if ConfigDropdownObj then
                ConfigDropdownObj.Refresh(GetSavedConfigNames())
                LunoLibrary:Notify({Title = "Refreshed", Content = "Config list updated!", Duration = 2})
            end
        end
    })

    ---------------------------------------------------------
    -- HIDDEN USER PROFILE PAGE
    ---------------------------------------------------------
    local ProfilePage = Instance.new("Frame")
    ProfilePage.Size = UDim2.new(1, 0, 1, 0)
    ProfilePage.BackgroundTransparency = 1
    ProfilePage.Visible = false
    ProfilePage.Parent = ContentContainer

    local ProfileTabObj = { Button = nil, Page = ProfilePage }
    Tabs["__UserProfile__"] = ProfileTabObj

    UserCard.MouseButton1Click:Connect(function() SwitchTab(ProfileTabObj) end)

    local ProfileScroll = Instance.new("ScrollingFrame")
    ProfileScroll.Size = UDim2.new(1, -10, 1, 0)
    ProfileScroll.BackgroundTransparency = 1
    ProfileScroll.BorderSizePixel = 0
    ProfileScroll.ScrollBarThickness = 3
    ProfileScroll.ScrollBarImageColor3 = Color3.fromRGB(0, 102, 255)
    ProfileScroll.Parent = ProfilePage

    local ProfileLayout = Instance.new("UIListLayout") ProfileLayout.Padding = UDim.new(0, 6) ProfileLayout.Parent = ProfileScroll

    local function CreateProfileItem(Text, Callback)
        local Btn = Instance.new("TextButton")
        Btn.Size = UDim2.new(1, -6, 0, 34)
        Btn.BackgroundColor3 = Color3.fromRGB(16, 22, 36)
        Btn.Text = Text
        Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        Btn.TextSize = 11
        Btn.Font = Enum.Font.GothamBold
        Btn.Parent = ProfileScroll

        local BtnCorner = Instance.new("UICorner") BtnCorner.CornerRadius = UDim.new(0, 6) BtnCorner.Parent = Btn
        if Callback then Btn.MouseButton1Click:Connect(Callback) end
        ProfileScroll.CanvasSize = UDim2.new(0, 0, 0, ProfileLayout.AbsoluteContentSize.Y + 8)
    end

    CreateProfileItem("👤 User ID: " .. tostring(LocalPlayer.UserId), function() setclipboard(tostring(LocalPlayer.UserId)) end)
    CreateProfileItem("🎮 Game: " .. CurrentGameName, nil)
    CreateProfileItem("🔑 Job ID: " .. tostring(game.JobId), function() setclipboard(tostring(game.JobId)) end)
    CreateProfileItem("🔄 Rejoin Server", function() TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer) end)
    CreateProfileItem("🔀 Server Hop (Random)", function()
        pcall(function()
            local req = game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/0?sortOrder=Desc&limit=100")
            local body = HttpService:JSONDecode(req)
            if body and body.data then
                for _, s in ipairs(body.data) do
                    if s.id ~= game.JobId and s.playing < s.maxPlayers then
                        TeleportService:TeleportToPlaceInstance(game.PlaceId, s.id, LocalPlayer)
                        break
                    end
                end
            end
        end)
    end)
    CreateProfileItem("📉 Small Server Hop (Lowest Players)", function()
        pcall(function()
            local req = game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/0?sortOrder=Asc&limit=100")
            local body = HttpService:JSONDecode(req)
            if body and body.data then
                for _, s in ipairs(body.data) do
                    if s.id ~= game.JobId and s.playing > 0 and s.playing < s.maxPlayers then
                        TeleportService:TeleportToPlaceInstance(game.PlaceId, s.id, LocalPlayer)
                        break
                    end
                end
            end
        end)
    end)

    return LunoLibrary
end

return LunoLibrary
