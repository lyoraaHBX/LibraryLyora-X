local function WrapElement(Instance, Flag, SetterFn, ExtraMethods)
    local Obj = {Instance = Instance}
    function Obj:Set(v) if SetterFn then SetterFn(v) end end
    function Obj:Get() if Flag then return LunoLibrary.Flags[Flag] end end
    function Obj:Destroy() if Instance then pcall(function() Instance:Destroy() end) end end
    function Obj:SetVisible(v) if Instance then Instance.Visible = v end end
    if ExtraMethods then for k, fn in pairs(ExtraMethods) do Obj[k] = fn end end
    return Obj
end

local function NewDeferred()
    local real = nil
    local queue = {}
    local D = {}
    local function enqueueOrRun(method, ...)
        if real then
            local fn = real[method]
            if fn then return fn(real, ...) end
        else
            table.insert(queue, {method, {...}})
        end
    end
    function D:Set(...) return enqueueOrRun("Set", ...) end
    function D:Get() if real then return real:Get() end end
    function D:Destroy() return enqueueOrRun("Destroy") end
    function D:SetVisible(v) return enqueueOrRun("SetVisible", v) end
    function D:Refresh(...) return enqueueOrRun("Refresh", ...) end
    function D._bind(obj)
        real = obj
        for _, c in ipairs(queue) do
            local fn = real[c[1]]
            if fn then pcall(fn, real, table.unpack(c[2])) end
        end
        queue = {}
    end
    return D
end

