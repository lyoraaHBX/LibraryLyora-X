    local function CreateTabInternal(TabName, FixedOrder, IsHidden)
        local LayoutOrderValue = FixedOrder or (UserTabCounter + 1)
        if not FixedOrder then UserTabCounter = UserTabCounter + 1 end

        local TabButton = nil
        if not IsHidden then
            TabButton = Instance.new("TextButton")
            TabButton.Size                 = UDim2.new(1, 0, 0, 32)
            TabButton.BackgroundColor3     = Color3.fromRGB(18, 26, 42)
            TabButton.BackgroundTransparency = 1
