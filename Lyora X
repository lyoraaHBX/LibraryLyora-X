                LunoLibrary:Notify({Title="Imported", Content="Config loaded from clipboard!", Type="Success", Duration=3})
            else
                LunoLibrary:Notify({Title="Error", Content="Invalid config format!", Type="Error", Duration=3})
            end
        end
    })

    local ProfilePage = Create("Frame", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Visible = false,
        Parent = ContentContainer,
    })

    local ProfileTabObj = { Holder = nil, Page = ProfilePage, Hidden = true, Loaded = true, Flush = function() end }
    Tabs["__UserProfile__"] = ProfileTabObj

    UserCard.MouseButton1Click:Connect(function() SwitchTab(ProfileTabObj) end)

    local ProfileScroll2 = Create("ScrollingFrame", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = Y2K.Neon,
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        Parent = ProfilePage,
    })
    Create("UIPadding", {
        PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 10),
        PaddingTop = UDim.new(0, 2), PaddingBottom = UDim.new(0, 10),
        Parent = ProfileScroll2,
    })
    Create("UIListLayout", {Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = ProfileScroll2})

    local ProfileOrder = 0
    local function CreateProfileItem(Text, CB)
        ProfileOrder = ProfileOrder + 1
        local PBtn = Create("TextButton", {
            Size = UDim2.new(1, 0, 0, UIScale.RowHeight),
            ThemeBackground = "BgInput",
            Text = Text,
            ThemeText = "Text",
            TextSize = UIScale.ElementFontSize,
            Font = FontBody,
            TextTruncate = Enum.TextTruncate.AtEnd,
            AutoButtonColor = false,
            LayoutOrder = ProfileOrder,
            Parent = ProfileScroll2,
        })
        AddCorner(PBtn, 8)
        Create("UIPadding", {PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 14), Parent = PBtn})
        PBtn.TextXAlignment = Enum.TextXAlignment.Left
        local pStroke = AddChromeStroke(PBtn, 1, 0.6)
        AddHoverGlow(PBtn, pStroke)
        if CB then PBtn.MouseButton1Click:Connect(function() task.spawn(CB) end) end
    end

    local function CopyNotify(label, value)
        RealSetClipboard(value)
        LunoLibrary:Notify({Title="Copied", Content=label.." copied to clipboard.", Duration=2})
    end

    local function ServerHop(order, needPlayers)
        task.spawn(function()
            local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/0?sortOrder=" .. order .. "&limit=100"
            local raw = SafeHttpGet(url)
            if not raw then
                LunoLibrary:Notify({Title="Server Hop", Content="Failed to fetch server list.", Type="Error", Duration=3})
                return
            end
            local ok, body = pcall(function() return HttpService:JSONDecode(raw) end)
            if ok and body and body.data then
                for _, s in ipairs(body.data) do
                    if s.id ~= game.JobId and s.playing < s.maxPlayers and (not needPlayers or s.playing > 0) then
                        LunoLibrary:Notify({Title="Server Hop", Content="Teleporting...", Duration=2})
                        TeleportService:TeleportToPlaceInstance(game.PlaceId, s.id, LocalPlayer)
                        return
                    end
                end
            end
            LunoLibrary:Notify({Title="Server Hop", Content="No server found.", Type="Warning", Duration=3})
        end)
    end

    CreateProfileItem("Username: " .. LocalPlayer.Name, function() CopyNotify("Username", LocalPlayer.Name) end)
    CreateProfileItem("User ID: " .. tostring(LocalPlayer.UserId), function() CopyNotify("User ID", tostring(LocalPlayer.UserId)) end)
    CreateProfileItem("Game: " .. CurrentGameName, nil)
    CreateProfileItem("Job ID: " .. tostring(game.JobId), function() CopyNotify("Job ID", tostring(game.JobId)) end)
    CreateProfileItem("Rejoin Server", function()
        pcall(function() TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer) end)
    end)
    CreateProfileItem("Server Hop (Random)", function() ServerHop("Desc", false) end)
    CreateProfileItem("Small Server Hop (Lowest Players)", function() ServerHop("Asc", true) end)

    SwitchTab(Tabs["MISC"])

    task.delay(0.6, function()
        if not MainScreenGui or not MainScreenGui.Parent then return end
        if DeviceType == "PC" then
            LunoLibrary:Notify({Title="PC / Laptop Detected", Content="Press " .. ToggleKeyName .. " to hide / show the menu.", Duration=6})
        elseif DeviceType == "Tablet" then
            LunoLibrary:Notify({Title="Tablet Detected", Content="Tap the LUNO floating button to hide / show the menu.", Duration=6})
        else
            LunoLibrary:Notify({Title="Mobile Detected", Content="Tap the LUNO floating button to hide / show the menu.", Duration=6})
        end
    end)

    return LunoLibrary
end

return LunoLibrary
