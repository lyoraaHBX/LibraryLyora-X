    -- CONTENT CONTAINER
    ---------------------------------------------------------
    local ContentContainer = Instance.new("Frame")
    ContentContainer.Size = UDim2.new(1, -170, 1, -82)
    ContentContainer.Position = UDim2.new(0, 165, 0, 78)
    ContentContainer.BackgroundTransparency = 1
    ContentContainer.Parent = MainFrame

    local Tabs = {}
    local ActiveTab = nil

    local function SwitchTab(TargetTab)
        for _, tab in pairs(Tabs) do
            tab.Button.BackgroundTransparency = 1
            tab.Button.TextColor3 = Color3.fromRGB(130, 150, 180)
            tab.Page.Visible = false
        end
        TargetTab.Button.BackgroundTransparency = 0
        TargetTab.Button.BackgroundColor3 = Color3.fromRGB(0, 102, 255)
        TargetTab.Button.TextColor3 = Color3.fromRGB(255, 255, 255)
        TargetTab.Page.Visible = true
        ActiveTab = TargetTab
    end

    function LunoLibrary:CreateTab(TabName)
        local TabButton = Instance.new("TextButton")
        TabButton.Size = UDim2.new(1, 0, 0, 32)
        TabButton.BackgroundColor3 = Color3.fromRGB(18, 26, 42)
        TabButton.BackgroundTransparency = 1
        TabButton.Text = "   " .. TabName
        TabButton.TextColor3 = Color3.fromRGB(130, 150, 180)
        TabButton.TextSize = 11
        TabButton.Font = Enum.Font.GothamMedium
        TabButton.TextXAlignment = Enum.TextXAlignment.Left
        TabButton.Parent = NavContainer

        local TabCorner = Instance.new("UICorner")
        TabCorner.CornerRadius = UDim.new(0, 6)
        TabCorner.Parent = TabButton

        local TabPage = Instance.new("Frame")
        TabPage.Size = UDim2.new(1, 0, 1, 0)
        TabPage.BackgroundTransparency = 1
        TabPage.Visible = false
        TabPage.Parent = ContentContainer

        local TabObj = { Button = TabButton, Page = TabPage }
        Tabs[TabName] = TabObj

        if not ActiveTab then
            SwitchTab(TabObj)
        end

        TabButton.MouseButton1Click:Connect(function()
            SwitchTab(TabObj)
        end)

        local TabElements = {}

        -- Script List Card Builder
        function TabElements:CreateScriptList()
            local SearchFrame = Instance.new("Frame")
            SearchFrame.Size = UDim2.new(1, -10, 0, 28)
            SearchFrame.BackgroundColor3 = Color3.fromRGB(16, 22, 36)
            SearchFrame.Parent = TabPage

            local SearchCorner = Instance.new("UICorner")
            SearchCorner.CornerRadius = UDim.new(0, 6)
            SearchCorner.Parent = SearchFrame

            local SearchBox = Instance.new("TextBox")
            SearchBox.Size = UDim2.new(1, -12, 1, 0)
            SearchBox.Position = UDim2.new(0, 8, 0, 0)
            SearchBox.BackgroundTransparency = 1
            SearchBox.PlaceholderText = "🔍 Search script name..."
            SearchBox.PlaceholderColor3 = Color3.fromRGB(90, 110, 140)
            SearchBox.Text = ""
            SearchBox.TextColor3 = Color3.fromRGB(255, 255, 255)
            SearchBox.TextSize = 10
            SearchBox.Font = Enum.Font.Gotham
            SearchBox.TextXAlignment = Enum.TextXAlignment.Left
            SearchBox.Parent = SearchFrame

            local ScrollList = Instance.new("ScrollingFrame")
            ScrollList.Size = UDim2.new(1, -10, 1, -36)
            ScrollList.Position = UDim2.new(0, 0, 0, 34)
            ScrollList.BackgroundTransparency = 1
            ScrollList.BorderSizePixel = 0
            ScrollList.ScrollBarThickness = 3
            ScrollList.ScrollBarImageColor3 = Color3.fromRGB(0, 102, 255)
            ScrollList.Parent = TabPage

            local CardsLayout = Instance.new("UIListLayout")
            CardsLayout.Padding = UDim.new(0, 6)
            CardsLayout.SortOrder = Enum.SortOrder.LayoutOrder
            CardsLayout.Parent = ScrollList

            local CardsList = {}

            SearchBox:GetPropertyChangedSignal("Text"):Connect(function()
                local text = string.lower(SearchBox.Text)
                for _, item in ipairs(CardsList) do
                    item.CardFrame.Visible = string.find(string.lower(item.Title), text) ~= nil
                end
                ScrollList.CanvasSize = UDim2.new(0, 0, 0, CardsLayout.AbsoluteContentSize.Y + 10)
            end)

            local ScriptListObj = {}
            function ScriptListObj:AddCard(CardData)
                CardData = CardData or {}
                local Title = CardData.Title or "Script Title"
                local Desc = CardData.Description or "Description here..."
                local Icon = CardData.Icon or "rbxassetid://6031763426"
                local Callback = CardData.Callback or function() end

                local Card = Instance.new("Frame")
                Card.Size = UDim2.new(1, -6, 0, 50)
                Card.BackgroundColor3 = Color3.fromRGB(15, 22, 36)
                Card.Parent = ScrollList

                local CardCorner = Instance.new("UICorner")
                CardCorner.CornerRadius = UDim.new(0, 6)
                CardCorner.Parent = Card

                local CardIcon = Instance.new("ImageLabel")
                CardIcon.Size = UDim2.new(0, 34, 0, 34)
                CardIcon.Position = UDim2.new(0, 8, 0.5, -17)
                CardIcon.Image = Icon
                CardIcon.BackgroundTransparency = 1
                CardIcon.Parent = Card

                local CardTitle = Instance.new("TextLabel")
                CardTitle.Size = UDim2.new(1, -140, 0, 16)
                CardTitle.Position = UDim2.new(0, 48, 0, 8)
                CardTitle.BackgroundTransparency = 1
                CardTitle.Text = Title
                CardTitle.TextColor3 = Color3.fromRGB(255, 255, 255)
                CardTitle.TextSize = 11
                CardTitle.Font = Enum.Font.GothamBold
                CardTitle.TextXAlignment = Enum.TextXAlignment.Left
                CardTitle.Parent = Card

                local CardDesc = Instance.new("TextLabel")
                CardDesc.Size = UDim2.new(1, -140, 0, 14)
                CardDesc.Position = UDim2.new(0, 48, 0, 26)
                CardDesc.BackgroundTransparency = 1
                CardDesc.Text = Desc
                CardDesc.TextColor3 = Color3.fromRGB(110, 130, 160)
                CardDesc.TextSize = 9
                CardDesc.Font = Enum.Font.Gotham
                CardDesc.TextXAlignment = Enum.TextXAlignment.Left
                CardDesc.TextTruncate = Enum.TextTruncate.AtEnd
                CardDesc.Parent = Card

                local CopyBtn = Instance.new("TextButton")
                CopyBtn.Size = UDim2.new(0, 65, 0, 26)
                CopyBtn.Position = UDim2.new(1, -73, 0.5, -13)
                CopyBtn.BackgroundColor3 = Color3.fromRGB(0, 102, 255)
                CopyBtn.Text = "📋 Execute"
                CopyBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
                CopyBtn.TextSize = 9
                CopyBtn.Font = Enum.Font.GothamBold
                CopyBtn.Parent = Card

                local CopyCorner = Instance.new("UICorner")
                CopyCorner.CornerRadius = UDim.new(0, 5)
                CopyCorner.Parent = CopyBtn

                CopyBtn.MouseButton1Click:Connect(function()
                    Callback()
                    CopyBtn.Text = "✓ Done"
                    task.wait(1)
                    CopyBtn.Text = "📋 Execute"
                end)

                table.insert(CardsList, { Title = Title, CardFrame = Card })
                ScrollList.CanvasSize = UDim2.new(0, 0, 0, CardsLayout.AbsoluteContentSize.Y + 10)
            end
            return ScriptListObj
        end

        -- Standard Controls Scroll
        local ScrollElements = Instance.new("ScrollingFrame")
