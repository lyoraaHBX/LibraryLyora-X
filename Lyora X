local function AddChromeStroke(parent, thickness, transparency, shimmer)
    local st = Instance.new("UIStroke")
    st.Color           = Y2K.Neon
    st.Thickness       = thickness or 1
    st.Transparency    = transparency or 0.5
    st.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    st.Parent          = parent
    Themed(st, "Color", "Neon")
    if shimmer then
        local g = Instance.new("UIGradient")
        g.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0,   Y2K.Chrome),
            ColorSequenceKeypoint.new(0.5, Y2K.Neon),
            ColorSequenceKeypoint.new(1,   Y2K.Chrome),
        })
        g.Parent = st
        RegisterShimmer(g)
    end
    return st
end

local function AddChromeText(label, rot)
    local g = Instance.new("UIGradient")
    g.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0,   Y2K.Chrome),
        ColorSequenceKeypoint.new(0.5, Y2K.NeonSoft),
        ColorSequenceKeypoint.new(1,   Y2K.Chrome),
    })
    g.Rotation = rot or 90
    g.Parent = label
    return g
end

local function AddHoverGlow(obj, stroke, offT, onT)
    offT = offT or 0.6
    onT  = onT  or 0.05
    obj.MouseEnter:Connect(function()
        TweenService:Create(stroke, TweenInfo.new(0.15), {Transparency = onT}):Play()
    end)
