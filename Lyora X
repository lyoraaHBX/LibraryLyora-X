local function Create(class, props)
    local inst = Instance.new(class)
    local parent, themeBG, themeText, themeStroke
    for k, v in pairs(props or {}) do
        if k == "Parent" then parent = v
        elseif k == "ThemeBackground" then themeBG = v
        elseif k == "ThemeText" then themeText = v
        elseif k == "ThemeStroke" then themeStroke = v
        else inst[k] = v end
    end
    if themeBG then Themed(inst, "BackgroundColor3", themeBG) end
    if themeText then Themed(inst, "TextColor3", themeText) end
    if themeStroke then Themed(inst, "Color", themeStroke) end
    if parent then inst.Parent = parent end
    return inst
end

