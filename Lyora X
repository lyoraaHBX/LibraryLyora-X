local _notifHolder = nil
local _notifCount  = 0

local function getHolder(sg)
    if _notifHolder and _notifHolder.Parent then
        return _notifHolder
    end
    _notifHolder = Create("Frame", {
        Name                   = "AuraNotifHolder",
        Size                   = UDim2.new(0, 320, 1, -20),
        Position               = UDim2.new(1, -330, 0, 10),
        BackgroundTransparency = 1,
        ZIndex                 = 9000,
        Parent                 = sg,
    })
    if not _notifHolder then return nil end
    local l = ListLayout(_notifHolder, 10)
    if l then
        l.VerticalAlignment   = Enum.VerticalAlignment.Bottom
        l.HorizontalAlignment = Enum.HorizontalAlignment.Right
    end
    Padding(_notifHolder, 10, 10, 0, 0)
    return _notifHolder
end

function AuraUI.Notify(opts, sg)
    opts = opts or {}
    local title     = tostring(opts.Title   or "Notice")
    local message   = tostring(opts.Message or "")
    local nType     = tostring(opts.Type    or "info")
    local duration  = tonumber(opts.Duration) or 4

    -- Cari ScreenGui
    local screenGui = sg
    if not screenGui then
        pcall(function()
            screenGui = CoreGui:FindFirstChild("AuraUI_Root")
        end)
    end
    if not screenGui then return end

    _notifCount = _notifCount + 1

    local holder = getHolder(screenGui)
    if not holder then return end

    -- Config per tipe
    local cfgMap = {
        info    = { accent=Color3.fromRGB(80,180,255),  bg=Color3.fromRGB(14,20,36),  iconTxt="i",  label="INFO"    },
        success = { accent=Color3.fromRGB(80,220,140),  bg=Color3.fromRGB(12,28,20),  iconTxt="✓",  label="SUCCESS" },
        warning = { accent=Color3.fromRGB(255,190,60),  bg=Color3.fromRGB(28,22,10),  iconTxt="!",  label="WARNING" },
        error   = { accent=Color3.fromRGB(255,80,100),  bg=Color3.fromRGB(28,12,16),  iconTxt="✕",  label="ERROR"   },
    }
    local c = cfgMap[nType] or cfgMap.info

    -- ── CARD ──────────────────────────────────────────
    local card = Create("Frame", {
        Name             = "AuraNotif_".._notifCount,
        Size             = UDim2.new(1, 0, 0, 84),
        BackgroundColor3 = c.bg,
        ClipsDescendants = true,
        ZIndex           = 9001,
        Parent           = holder,
    })
    if not card then return end
    Corner(card, 14)

    -- Stroke border tipis warna accent
    local st = Instance.new("UIStroke")
    st.Color        = c.accent
    st.Thickness    = 1
    st.Transparency = 0.6
    st.Parent       = card

    -- Gradient bg
    local grd = Instance.new("UIGradient")
    grd.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0,   c.bg),
        ColorSequenceKeypoint.new(1,   Color3.fromRGB(14,14,22)),
    })
    grd.Rotation = 120
    grd.Parent   = card

    -- Accent bar kiri
    local bar = Create("Frame", {
        Size             = UDim2.new(0, 3, 1, -20),
        Position         = UDim2.new(0, 0, 0, 10),
        BackgroundColor3 = c.accent,
        ZIndex           = 9003,
        Parent           = card,
    })
    Corner(bar, 99)

    -- Icon circle
    local iconBg = Create("Frame", {
        Size             = UDim2.new(0, 34, 0, 34),
        Position         = UDim2.new(0, 16, 0.5, -17),
        BackgroundColor3 = c.accent,
        BackgroundTransparency = 0.8,
        ZIndex           = 9003,
        Parent           = card,
    })
    Corner(iconBg, 99)
    Stroke(iconBg, c.accent, 1)

    Create("TextLabel", {
        Size                   = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text                   = c.iconTxt,
        TextColor3             = c.accent,
        TextSize               = 14,
        Font                   = Enum.Font.GothamBold,
        ZIndex                 = 9004,
        Parent                 = iconBg,
    })

    -- Badge label tipe
    local badge = Create("Frame", {
        Size             = UDim2.new(0, 58, 0, 15),
        Position         = UDim2.new(0, 58, 0, 11),
        BackgroundColor3 = c.accent,
        BackgroundTransparency = 0.78,
        ZIndex           = 9003,
        Parent           = card,
    })
    Corner(badge, 5)
    Create("TextLabel", {
        Size                   = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text                   = c.label,
        TextColor3             = c.accent,
        TextSize               = 9,
        Font                   = Enum.Font.GothamBold,
        ZIndex                 = 9004,
        Parent                 = badge,
    })

    -- Title
    Create("TextLabel", {
        Size                   = UDim2.new(1, -100, 0, 18),
        Position               = UDim2.new(0, 58, 0, 28),
        BackgroundTransparency = 1,
        Text                   = title,
        TextColor3             = Theme.TextPrimary,
        TextSize               = 13,
        Font                   = Enum.Font.GothamBold,
        TextXAlignment         = Enum.TextXAlignment.Left,
        TextTruncate           = Enum.TextTruncate.AtEnd,
        ZIndex                 = 9004,
        Parent                 = card,
    })

    -- Message
    Create("TextLabel", {
        Size                   = UDim2.new(1, -66, 0, 22),
        Position               = UDim2.new(0, 58, 0, 48),
        BackgroundTransparency = 1,
        Text                   = message,
        TextColor3             = Theme.TextSecondary,
        TextSize               = 11,
        Font                   = Enum.Font.Gotham,
        TextXAlignment         = Enum.TextXAlignment.Left,
        TextWrapped            = true,
        TextTruncate           = Enum.TextTruncate.AtEnd,
        ZIndex                 = 9004,
        Parent                 = card,
    })

    -- Close button
    local closeBtn = Create("TextButton", {
        Size             = UDim2.new(0, 20, 0, 20),
        Position         = UDim2.new(1, -26, 0, 8),
        BackgroundColor3 = Color3.fromRGB(255,255,255),
        BackgroundTransparency = 0.9,
        Text             = "✕",
        TextColor3       = Theme.TextMuted,
        TextSize         = 9,
        Font             = Enum.Font.GothamBold,
        AutoButtonColor  = false,
        ZIndex           = 9006,
        Parent           = card,
    })
    Corner(closeBtn, 6)
    closeBtn.MouseEnter:Connect(function()
        Tween(closeBtn,{BackgroundTransparency=0.7, TextColor3=Color3.fromRGB(255,255,255)},0.12)
    end)
    closeBtn.MouseLeave:Connect(function()
        Tween(closeBtn,{BackgroundTransparency=0.9, TextColor3=Theme.TextMuted},0.12)
    end)

    -- Progress bar
    local progTrack = Create("Frame", {
        Size             = UDim2.new(1, -16, 0, 2),
        Position         = UDim2.new(0, 8, 1, -4),
        BackgroundColor3 = Color3.fromRGB(25,25,40),
        ZIndex           = 9003,
        Parent           = card,
    })
    Corner(progTrack, 99)
    local progFill = Create("Frame", {
        Size             = UDim2.new(1, 0, 1, 0),
        BackgroundColor3 = c.accent,
        ZIndex           = 9004,
        Parent           = progTrack,
    })
    Corner(progFill, 99)

    -- ── ANIMASI MASUK ──────────────────────────────────
    card.Position               = UDim2.new(1.1, 0, 0, 0)
    card.BackgroundTransparency = 0.4

    local tIn = TweenService:Create(card,
        TweenInfo.new(0.42, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
        {Position=UDim2.new(0,0,0,0), BackgroundTransparency=0})
    tIn:Play()

    -- Progress habis sesuai duration
    Tween(progFill, {Size=UDim2.new(0,0,1,0)}, duration, Enum.EasingStyle.Linear)

    -- ── DISMISS ────────────────────────────────────────
    local dismissed = false
    local function dismiss()
        if dismissed then return end
        dismissed = true
        local tOut = TweenService:Create(card,
            TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.In),
            {Position=UDim2.new(1.1,0,0,0), BackgroundTransparency=0.5})
        local tShrink = TweenService:Create(card,
            TweenInfo.new(0.28, Enum.EasingStyle.Quart, Enum.EasingDirection.In),
            {Size=UDim2.new(1,0,0,0)})
        tOut:Play()
        task.delay(0.15, function() tShrink:Play() end)
        tOut.Completed:Connect(function()
            task.wait(0.05)
            pcall(function() card:Destroy() end)
        end)
    end

    task.delay(duration, dismiss)
    closeBtn.MouseButton1Click:Connect(dismiss)

    -- Overlay click to dismiss
    local overlay = Create("TextButton", {
        Size                   = UDim2.new(1,0,1,0),
        BackgroundTransparency = 1,
        Text                   = "",
        ZIndex                 = 9005,
        Parent                 = card,
    })
    overlay.MouseEnter:Connect(function()
        st.Transparency = 0.25
        Tween(card, {BackgroundColor3=Color3.fromRGB(
            math.min(c.bg.R*255+6,255),
            math.min(c.bg.G*255+6,255),
            math.min(c.bg.B*255+10,255)
        )}, 0.12)
    end)
    overlay.MouseLeave:Connect(function()
        st.Transparency = 0.6
        Tween(card, {BackgroundColor3=c.bg}, 0.12)
    end)
    overlay.MouseButton1Click:Connect(dismiss)
end

