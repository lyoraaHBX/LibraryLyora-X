            Arrow.Position          = UDim2.new(1, -25, 0, 0)
            Arrow.BackgroundTransparency = 1
            Arrow.Text              = "▼"
            Arrow.TextColor3        = Color3.fromRGB(120, 140, 170)
            Arrow.TextSize          = 10
            Arrow.Font              = Enum.Font.TitilliumWeb
            Arrow.Parent            = DropFrame

