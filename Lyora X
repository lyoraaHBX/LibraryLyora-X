function AuraUI.new(config)
    config = config or {}
    local self     = setmetatable({}, AuraUI)
    self.Title     = config.Title   or "AuraUI"
    self.WinSize   = config.Size    or UDim2.new(0, 620, 0, 460)
    self.Keybind   = config.Keybind or Enum.KeyCode.RightShift
    self.Visible   = true
    self.Animating = false
    self.Tabs      = {}
    self.ActiveTab = nil
    self.IsMobile  = UserInputService.TouchEnabled
                  and not UserInputService.KeyboardEnabled

    self:_buildRoot()
    self:_buildWindow()
    self:_buildTitleBar()
    self:_buildSidebar()
    self:_buildContent()
    self:_setupKeybind()
    if self.IsMobile then self:_buildMobileBtn() end
    self:_loadProfile()

    task.delay(0.7, function()
        AuraUI.Notify({
            Title    = "AuraUI v2.4",
            Message  = "Loaded! Press RightShift to toggle.",
            Type     = "success",
            Duration = 4,
        }, self.ScreenGui)
    end)

    return self
end

function AuraUI:_buildRoot()
    pcall(function()
        local old = CoreGui:FindFirstChild("AuraUI_Root")
        if old then old:Destroy() end
    end)
    self.ScreenGui = Create("ScreenGui", {
        Name           = "AuraUI_Root",
        ResetOnSpawn   = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        DisplayOrder   = 999,
        Parent         = CoreGui,
    })
end

function AuraUI:_buildWindow()
    self.Container = Create("Frame", {
        Name                   = "Container",
        Size                   = self.WinSize,
        Position               = UDim2.new(
            0.5, -self.WinSize.X.Offset/2,
            0.5, -self.WinSize.Y.Offset/2),
        BackgroundTransparency = 1,
        ZIndex                 = 1,
        Parent                 = self.ScreenGui,
    })
    self.MainFrame = Create("Frame", {
        Name             = "MainWindow",
        Size             = UDim2.new(1,0,1,0),
        BackgroundColor3 = Theme.Background,
        ClipsDescendants = false,
        ZIndex           = 2,
        Parent           = self.Container,
    })
    Corner(self.MainFrame, 18)
    Stroke(self.MainFrame, Theme.Border, 1.5)

    local g = Instance.new("UIGradient")
    g.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(16,14,26)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(10,10,18)),
    })
    g.Rotation = 135
    g.Parent   = self.MainFrame

    self.InnerClip = Create("Frame", {
        Name                   = "InnerClip",
        Size                   = UDim2.new(1,0,1,0),
        BackgroundTransparency = 1,
        ClipsDescendants       = true,
        ZIndex                 = 2,
        Parent                 = self.MainFrame,
    })
    Corner(self.InnerClip, 18)
end

