    ---------------------------------------------------------
    -- CONTENT CONTAINER & TAB LOGIC
    ---------------------------------------------------------
    local ContentContainer = Instance.new("Frame")
    ContentContainer.Size = UDim2.new(1, -170, 1, -82)
    ContentContainer.Position = UDim2.new(0, 165, 0, 78)
    ContentContainer.BackgroundTransparency = 1
    ContentContainer.Parent = MainFrame

    local Tabs = {}
    local ActiveTab = nil

    local function SwitchTab(TargetTab)
        for _, tab in pairs(Tabs) do
            if tab.Button then
                tab.Button.BackgroundTransparency = 1
                tab.Button.TextColor3 = Color3.fromRGB(130, 150, 180)
            end
            tab.Page.Visible = false
        end
        if TargetTab.Button then
            TargetTab.Button.BackgroundTransparency = 0
            TargetTab.Button.BackgroundColor3 = Color3.fromRGB(0, 102, 255)
            TargetTab.Button.TextColor3 = Color3.fromRGB(255, 255, 255)
        end
        TargetTab.Page.Visible = true
        ActiveTab = TargetTab
    end

    function LunoLibrary:CreateTab(TabName)
        local TabButton = Instance.new("TextButton")
        TabButton.Size = UDim2.new(1, 0, 0, 32)
        TabButton.BackgroundColor3 = Color3.fromRGB(18, 26, 42)
        TabButton.BackgroundTransparency = 1
        TabButton.Text = "   " .. TabName
        TabButton.TextColor3 = Color3.fromRGB(130, 150, 180)
        TabButton.TextSize = 11
        TabButton.Font = Enum.Font.GothamMedium
        TabButton.TextXAlignment = Enum.TextXAlignment.Left
        TabButton.Parent = NavContainer

        local TabCorner = Instance.new("UICorner") TabCorner.CornerRadius = UDim.new(0, 6) TabCorner.Parent = TabButton

        local TabPage = Instance.new("Frame")
        TabPage.Size = UDim2.new(1, 0, 1, 0)
        TabPage.BackgroundTransparency = 1
        TabPage.Visible = false
        TabPage.Parent = ContentContainer

        local TabObj = { Button = TabButton, Page = TabPage }
        Tabs[TabName] = TabObj

        if not ActiveTab then SwitchTab(TabObj) end

        TabButton.MouseButton1Click:Connect(function() SwitchTab(TabObj) end)

        local TabElements = {}

        local ScrollElements = Instance.new("ScrollingFrame")
        ScrollElements.Size = UDim2.new(1, -10, 1, 0)
        ScrollElements.BackgroundTransparency = 1
        ScrollElements.BorderSizePixel = 0
        ScrollElements.ScrollBarThickness = 3
        ScrollElements.ScrollBarImageColor3 = Color3.fromRGB(0, 102, 255)
        ScrollElements.Parent = TabPage

        local ElementsLayout = Instance.new("UIListLayout")
        ElementsLayout.Padding = UDim.new(0, 6)
        ElementsLayout.SortOrder = Enum.SortOrder.LayoutOrder
        ElementsLayout.Parent = ScrollElements

        -- Section Header
        function TabElements:CreateSection(SectionName)
            local SecLbl = Instance.new("TextLabel")
            SecLbl.Size = UDim2.new(1, -6, 0, 20)
            SecLbl.BackgroundTransparency = 1
            SecLbl.Text = string.upper(SectionName)
            SecLbl.TextColor3 = Color3.fromRGB(0, 140, 255)
            SecLbl.TextSize = 10
            SecLbl.Font = Enum.Font.GothamBold
            SecLbl.TextXAlignment = Enum.TextXAlignment.Left
            SecLbl.Parent = ScrollElements
            ScrollElements.CanvasSize = UDim2.new(0, 0, 0, ElementsLayout.AbsoluteContentSize.Y + 10)
        end

        -- Button
        function TabElements:CreateButton(Settings)
            local Name = Settings.Title or Settings.Name or "Button"
            local Callback = Settings.Callback or function() end

            local Btn = Instance.new("TextButton")
            Btn.Size = UDim2.new(1, -6, 0, 32)
            Btn.BackgroundColor3 = Color3.fromRGB(16, 22, 36)
            Btn.Text = Name
            Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            Btn.TextSize = 11
            Btn.Font = Enum.Font.GothamBold
            Btn.Parent = ScrollElements

            local BtnCorner = Instance.new("UICorner") BtnCorner.CornerRadius = UDim.new(0, 6) BtnCorner.Parent = Btn
            Btn.MouseButton1Click:Connect(Callback)
            ScrollElements.CanvasSize = UDim2.new(0, 0, 0, ElementsLayout.AbsoluteContentSize.Y + 10)
        end

        -- Toggle
        function TabElements:CreateToggle(Settings)
            local Name = Settings.Title or Settings.Name or "Toggle"
            local Default = Settings.Default or false
            local Callback = Settings.Callback or function() end
            local Toggled = Default

            local ToggleFrame = Instance.new("Frame")
            ToggleFrame.Size = UDim2.new(1, -6, 0, 32)
            ToggleFrame.BackgroundColor3 = Color3.fromRGB(16, 22, 36)
            ToggleFrame.Parent = ScrollElements

            local ToggleCorner = Instance.new("UICorner") ToggleCorner.CornerRadius = UDim.new(0, 6) ToggleCorner.Parent = ToggleFrame

            local ToggleLbl = Instance.new("TextLabel")
            ToggleLbl.Size = UDim2.new(1, -50, 1, 0)
            ToggleLbl.Position = UDim2.new(0, 10, 0, 0)
            ToggleLbl.BackgroundTransparency = 1
            ToggleLbl.Text = Name
            ToggleLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
            ToggleLbl.TextSize = 11
            ToggleLbl.Font = Enum.Font.Gotham
            ToggleLbl.TextXAlignment = Enum.TextXAlignment.Left
            ToggleLbl.Parent = ToggleFrame

            local Switch = Instance.new("Frame")
            Switch.Size = UDim2.new(0, 32, 0, 16)
            Switch.Position = UDim2.new(1, -40, 0.5, -8)
