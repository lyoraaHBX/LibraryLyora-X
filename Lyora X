        RealSetClipboard(tostring(game.JobId))
    end)
    CreateProfileItem("Rejoin Server", function()
        pcall(function()
            TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
        end)
    end)
    CreateProfileItem("Server Hop (Random)", function()
        pcall(function()
            local req  = game:HttpGet(
                "https://games.roblox.com/v1/games/"
                .. game.PlaceId
                .. "/servers/0?sortOrder=Desc&limit=100"
            )
            local body = HttpService:JSONDecode(req)
            if body and body.data then
                for _, s in ipairs(body.data) do
                    if s.id ~= game.JobId and s.playing < s.maxPlayers then
                        TeleportService:TeleportToPlaceInstance(
                            game.PlaceId, s.id, LocalPlayer)
                        break
                    end
                end
            end
        end)
    end)
    CreateProfileItem("Small Server Hop (Lowest Players)", function()
        pcall(function()
            local req  = game:HttpGet(
                "https://games.roblox.com/v1/games/"
                .. game.PlaceId
                .. "/servers/0?sortOrder=Asc&limit=100"
            )
            local body = HttpService:JSONDecode(req)
            if body and body.data then
                for _, s in ipairs(body.data) do
                    if s.id ~= game.JobId
                    and s.playing > 0
                    and s.playing < s.maxPlayers then
                        TeleportService:TeleportToPlaceInstance(
                            game.PlaceId, s.id, LocalPlayer)
                        break
                    end
                end
            end
        end)
    end)

    return LunoLibrary
end

return LunoLibrary
