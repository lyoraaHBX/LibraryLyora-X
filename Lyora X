    local ToastStroke = Instance.new("UIStroke") ToastStroke.Color = Color3.fromRGB(0, 110, 255) ToastStroke.Thickness = 1 ToastStroke.Transparency = 0.3 ToastStroke.Parent = Toast

    local ToastTitle = Instance.new("TextLabel")
