-- ── Clipboard ─────────────────────────────────────────────
local function RealSetClipboard(text)
    if setclipboard then setclipboard(text)
    elseif toclipboard then toclipboard(text)
    elseif syn and syn.write_clipboard then syn.write_clipboard(text)
    end
end

-- ── Safe File Helpers ─────────────────────────────────────
local function SafeWriteFile(path, content)
    if writefile then pcall(writefile, path, content) end
end
local function SafeReadFile(path)
    if readfile and isfile and isfile(path) then
        local ok, res = pcall(readfile, path)
        if ok then return res end
    end
    return nil
end
local function SafeMakeFolder(path)
    if makefolder and isfolder and not isfolder(path) then
        pcall(makefolder, path)
    end
end
local function SafeListFiles(path)
    if listfiles then
        local ok, res = pcall(listfiles, path)
        if ok then return res end
    end
    return {}
end
local function SafeDeleteFile(path)
    if delfile and isfile and isfile(path) then
        pcall(delfile, path)
    end
end

