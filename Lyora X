        -- ── Slider ────────────────────────────────────────
        function TabElements:CreateSlider(Opts)
            Opts = Opts or {}
            local Name      = Opts.Title or Opts.Name or "Slider"
            local Min       = Opts.Min or 0
            local Max       = Opts.Max or 100
            if Max <= Min then Max = Min + 1 end
            local Increment = Opts.Increment or 1
            local Default   = math.clamp(Opts.Default or Min, Min, Max)
            local Suffix    = Opts.Suffix or ""
            local Flag      = Opts.Flag; if Flag == nil then Flag = Name end
            local Callback  = Opts.Callback or function() end
            local boxed     = InsideBox
            local H         = UIScale.SliderHeight

            SetFlag(Flag, Default)

            local SliderFrame = Create("Frame", {
                Size = UDim2.new(1, 0, 0, H),
                BackgroundColor3 = Y2K.BgInput,
                LayoutOrder = PrepareRow(),
                Parent = CurrentContainer,
            })
            StyleRow(SliderFrame, boxed)

            Create("TextLabel", {
                Size = UDim2.new(1, -110, 0, 20),
                Position = UDim2.new(0, 14, 0, 7),
                BackgroundTransparency = 1,
                Text = Name,
                TextColor3 = Y2K.Text,
                TextSize = UIScale.ElementFontSize,
                Font = FontBody,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextTruncate = Enum.TextTruncate.AtEnd,
                Parent = SliderFrame,
            })

            local ValLbl = Create("TextLabel", {
                Size = UDim2.new(0, 90, 0, 20),
                Position = UDim2.new(1, -104, 0, 7),
                BackgroundTransparency = 1,
                Text = tostring(Default) .. Suffix,
                TextColor3 = Y2K.NeonSoft,
                TextSize = UIScale.ElementFontSize,
                Font = FontBold,
                TextXAlignment = Enum.TextXAlignment.Right,
                Parent = SliderFrame,
            })

            local Hit = Create("Frame", {
                Size = UDim2.new(1, -28, 0, 24),
                Position = UDim2.new(0, 14, 0, H - 28),
                BackgroundTransparency = 1,
                Parent = SliderFrame,
            })

            local Bar = Create("Frame", {
                Size = UDim2.new(1, 0, 0, 6),
                Position = UDim2.new(0, 0, 0.5, -3),
                BackgroundColor3 = Y2K.Track,
                Parent = Hit,
            })
            AddCorner(Bar, UDim.new(1, 0))

            local Fill = Create("Frame", {
                Size = UDim2.new((Default - Min) / (Max - Min), 0, 1, 0),
                BackgroundColor3 = Y2K.Neon,
                Parent = Bar,
            })
            AddCorner(Fill, UDim.new(1, 0))
            Create("UIGradient", {
                Color = ColorSequence.new({
                    ColorSequenceKeypoint.new(0, Y2K.Chrome),
                    ColorSequenceKeypoint.new(1, Y2K.Neon),
                }),
                Parent = Fill,
            })

            local Knob = Create("Frame", {
                Size = UDim2.new(0, 14, 0, 14),
                Position = UDim2.new((Default - Min) / (Max - Min), -7, 0.5, -7),
                BackgroundColor3 = Y2K.Chrome,
                ZIndex = 2,
                Parent = Bar,
            })
            AddCorner(Knob, UDim.new(1, 0))
            AddChromeStroke(Knob, 1.5, 0.1)

            local function Round(v)
                v = math.clamp(v, Min, Max)
                v = Min + math.floor((v - Min) / Increment + 0.5) * Increment
                v = math.clamp(v, Min, Max)
                return math.floor(v * 1000 + 0.5) / 1000
            end

            local LastValue = Default
            local function SetSliderValue(val)
                val = Round(tonumber(val) or Min)
                local pct = (val - Min) / (Max - Min)
                Fill.Size     = UDim2.new(pct, 0, 1, 0)
                Knob.Position = UDim2.new(pct, -7, 0.5, -7)
                ValLbl.Text   = tostring(val) .. Suffix
                SetFlag(Flag, val)
                if val ~= LastValue then
                    LastValue = val
                    task.spawn(Callback, val)
                end
            end

            local DraggingSlider = false
            local function UpdateSlider(input)
                local pct = math.clamp(
                    (input.Position.X - Bar.AbsolutePosition.X) / math.max(Bar.AbsoluteSize.X, 1),
                    0, 1
                )
                SetSliderValue(Min + (Max - Min) * pct)
            end

            Hit.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                    DraggingSlider = true
                    UpdateSlider(input)
                end
            end)
            RegisterConnection(UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                    DraggingSlider = false
                end
            end))
            RegisterConnection(UserInputService.InputChanged:Connect(function(input)
                if DraggingSlider and (
                    input.UserInputType == Enum.UserInputType.MouseMovement
                    or input.UserInputType == Enum.UserInputType.Touch
                ) then
                    UpdateSlider(input)
                end
            end))

            if Flag then LunoLibrary.Elements[Flag] = { Set = SetSliderValue } end
        end

