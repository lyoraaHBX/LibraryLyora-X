    local function activateThis()
        for _,t in ipairs(self.Tabs) do
            t.Page.Visible=false
            Tween(t.Button,{BackgroundColor3=Theme.Surface,BackgroundTransparency=0.5},0.2)
            local ab=t.Button:FindFirstChild("ActiveBar")
            if ab then Tween(ab,{BackgroundTransparency=1},0.2) end
