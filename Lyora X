        Create("TextLabel",{
            Size=UDim2.new(1,-130,0,44), Position=UDim2.new(0,14,0,0),
            BackgroundTransparency=1, Text=label,
            TextColor3=Theme.TextPrimary, TextSize=13, Font=Enum.Font.GothamSemibold,
            TextXAlignment=Enum.TextXAlignment.Left,
            ZIndex=9, Parent=main,
        })
        local selLbl=Create("TextLabel",{
            Size=UDim2.new(0,110,0,44), Position=UDim2.new(1,-138,0,0),
            BackgroundTransparency=1,
            Text=tostring(selected or "Select..."),
            TextColor3=Theme.TextAccent, TextSize=12, Font=Enum.Font.Gotham,
            TextXAlignment=Enum.TextXAlignment.Right,
            ZIndex=9, Parent=main,
        })
        local arrow=Create("TextLabel",{
            Size=UDim2.new(0,22,0,44), Position=UDim2.new(1,-30,0,0),
            BackgroundTransparency=1, Text="⌄",
            TextColor3=Theme.TextMuted, TextSize=14, Font=Enum.Font.GothamBold,
            ZIndex=9, Parent=main,
        })

        -- ── PANEL: pakai ScrollingFrame + ZIndex tinggi ──
        -- Di-parent langsung ke ScreenGui agar tidak
        -- terpotong oleh ScrollingFrame manapun di hierarki
        local screenGui = self.Library and self.Library.ScreenGui
        local panelParent = screenGui or page

        local MAX_VISIBLE_H = 180  -- max tinggi panel sebelum scroll
        local ITEM_H        = 34
        local PAD           = 8

        local panel = Create("ScrollingFrame",{
            Size             = UDim2.new(0, 0, 0, 0),
            BackgroundColor3 = Theme.BackgroundAlt,
            ClipsDescendants = true,
            Visible          = false,
            ScrollBarThickness      = 3,
            ScrollBarImageColor3    = Theme.Accent,
            ScrollBarImageTransparency = 0.4,
            ScrollingDirection      = Enum.ScrollingDirection.Y,
            CanvasSize              = UDim2.new(0,0,0,0),
            -- ZIndex sangat tinggi agar selalu di atas semua elemen
            ZIndex           = 500,
            Parent           = panelParent,
        })
        Corner(panel,12) Stroke(panel,Theme.Border,1)

        local pl2 = ListLayout(panel,2)
        pl2.HorizontalAlignment = Enum.HorizontalAlignment.Center
        Padding(panel,PAD,PAD,4,4)
        AutoCanvas(panel, pl2, PAD*2)

        -- Fungsi update posisi panel mengikuti posisi wrap di layar
        local function updatePanelPosition()
            local ap = main.AbsolutePosition
            local as = main.AbsoluteSize
            local totalH = #options * (ITEM_H + 2) + PAD * 2
            local panelH = math.min(totalH, MAX_VISIBLE_H)
            local panelW = as.X

            panel.Size     = UDim2.new(0, panelW, 0, panelH)
            panel.Position = UDim2.new(0, ap.X, 0, ap.Y + as.Y + 4)
        end

        local function buildOpts()
            for _,ch in ipairs(panel:GetChildren()) do
                if ch:IsA("TextButton") then ch:Destroy() end
            end
            for _,opt in ipairs(options) do
                local isSel=(opt==selected)
                local ob=Create("TextButton",{
                    Size=UDim2.new(1,0,0,ITEM_H),
                    BackgroundColor3=isSel and Theme.SurfaceHover or Theme.Surface,
                    Text="", AutoButtonColor=false,
                    ZIndex=501, Parent=panel,
                })
                Corner(ob,8)
                Create("TextLabel",{
                    Size=UDim2.new(0,18,1,0), Position=UDim2.new(0,8,0,0),
                    BackgroundTransparency=1, Text=isSel and "✓" or "",
                    TextColor3=Theme.Accent, TextSize=12, Font=Enum.Font.GothamBold,
                    ZIndex=502, Parent=ob,
                })
                Create("TextLabel",{
                    Size=UDim2.new(1,-28,1,0), Position=UDim2.new(0,26,0,0),
                    BackgroundTransparency=1, Text=tostring(opt),
                    TextColor3=isSel and Theme.TextPrimary or Theme.TextSecondary,
                    TextSize=12,
                    Font=isSel and Enum.Font.GothamSemibold or Enum.Font.Gotham,
                    TextXAlignment=Enum.TextXAlignment.Left,
                    ZIndex=502, Parent=ob,
                })
                ob.MouseEnter:Connect(function()
                    Tween(ob,{BackgroundColor3=Theme.SurfaceHover},0.1)
                end)
                ob.MouseLeave:Connect(function()
                    Tween(ob,{BackgroundColor3=opt==selected and Theme.SurfaceHover or Theme.Surface},0.1)
                end)
                ob.MouseButton1Click:Connect(function()
                    selected=opt
                    selLbl.Text=tostring(opt)
                    buildOpts()
                    isOpen=false
                    -- Tutup dengan animasi
                    Tween(panel,{Size=UDim2.new(0,panel.AbsoluteSize.X,0,0)},0.2)
                    Tween(arrow,{Rotation=0,TextColor3=Theme.TextMuted},0.2)
                    Tween(main, {BackgroundColor3=Theme.Surface},0.15)
                    task.delay(0.22,function() panel.Visible=false end)
                    pcall(callback,selected)
                end)
            end
        end
        buildOpts()

        main.MouseButton1Click:Connect(function()
            isOpen=not isOpen
            if isOpen then
                updatePanelPosition()
                panel.Visible=true
                local targetW = main.AbsoluteSize.X
                local totalH  = #options * (ITEM_H + 2) + PAD * 2
                local targetH = math.min(totalH, MAX_VISIBLE_H)
                -- Mulai dari size 0 lalu expand
                panel.Size = UDim2.new(0, targetW, 0, 0)
                Tween(panel,{Size=UDim2.new(0,targetW,0,targetH)},0.28,Enum.EasingStyle.Back)
                Tween(arrow,{Rotation=180,TextColor3=Theme.Accent},0.22)
                Tween(main, {BackgroundColor3=Theme.SurfaceHover},0.15)
            else
                local curW = panel.AbsoluteSize.X
                Tween(panel,{Size=UDim2.new(0,curW,0,0)},0.2)
                Tween(arrow,{Rotation=0,TextColor3=Theme.TextMuted},0.2)
                Tween(main, {BackgroundColor3=Theme.Surface},0.15)
                task.delay(0.22,function()
                    if not isOpen then panel.Visible=false end
                end)
            end
        end)

        main.MouseEnter:Connect(function()
            if not isOpen then Tween(main,{BackgroundColor3=Theme.SurfaceHover},0.15) end
        end)
        main.MouseLeave:Connect(function()
            if not isOpen then Tween(main,{BackgroundColor3=Theme.Surface},0.15) end
        end)

        -- Tutup dropdown jika klik di luar
        UserInputService.InputBegan:Connect(function(inp)
            if not isOpen then return end
            if inp.UserInputType ~= Enum.UserInputType.MouseButton1
            and inp.UserInputType ~= Enum.UserInputType.Touch then return end
            -- Cek apakah klik di dalam panel atau main
            local mx, my = inp.Position.X, inp.Position.Y
            local function insideFrame(f)
                local ap = f.AbsolutePosition
                local as = f.AbsoluteSize
                return mx>=ap.X and mx<=ap.X+as.X and my>=ap.Y and my<=ap.Y+as.Y
            end
            if not insideFrame(main) and not insideFrame(panel) then
                isOpen=false
                local curW = panel.AbsoluteSize.X
                Tween(panel,{Size=UDim2.new(0,curW,0,0)},0.2)
                Tween(arrow,{Rotation=0,TextColor3=Theme.TextMuted},0.2)
                Tween(main, {BackgroundColor3=Theme.Surface},0.15)
                task.delay(0.22,function()
                    if not isOpen then panel.Visible=false end
                end)
            end
        end)

        local obj={}
        function obj:Set(v) selected=v selLbl.Text=tostring(v) buildOpts() end
        function obj:Get() return selected end
        function obj:Refresh(newOpts) options=newOpts buildOpts() end
        return obj
    end

    function Tab:AddTextBox(cfg)
        cfg=cfg or {}
        local label    = cfg.Name        or "Input"
        local ph       = cfg.Placeholder or "Type here..."
        local default  = cfg.Default     or ""
        local callback = cfg.Callback    or function() end

        local card=Card(68)
        Create("TextLabel",{
            Size=UDim2.new(1,-20,0,18), Position=UDim2.new(0,14,0,8),
            BackgroundTransparency=1, Text=label,
            TextColor3=Theme.TextSecondary, TextSize=12, Font=Enum.Font.GothamSemibold,
            TextXAlignment=Enum.TextXAlignment.Left,
            ZIndex=5, Parent=card,
        })
        local inputBg=Create("Frame",{
            Size=UDim2.new(1,-20,0,30), Position=UDim2.new(0,10,0,30),
            BackgroundColor3=Theme.BackgroundAlt,
            ZIndex=5, Parent=card,
        })
        Corner(inputBg,8) Stroke(inputBg,Theme.Separator,1)
        local tb=Create("TextBox",{
            Size=UDim2.new(1,-16,1,0), Position=UDim2.new(0,10,0,0),
            BackgroundTransparency=1,
            PlaceholderText=ph, PlaceholderColor3=Theme.TextMuted,
            Text=default, TextColor3=Theme.TextPrimary,
            TextSize=12, Font=Enum.Font.Gotham,
            TextXAlignment=Enum.TextXAlignment.Left,
            ClearTextOnFocus=false,
            ZIndex=6, Parent=inputBg,
        })
        tb.Focused:Connect(function()
            Tween(inputBg,{BackgroundColor3=Theme.Surface},0.2)
            Stroke(inputBg,Theme.Accent,1.5)
            Tween(card,{BackgroundColor3=Theme.SurfaceHover},0.2)
        end)
        tb.FocusLost:Connect(function(enter)
            Tween(inputBg,{BackgroundColor3=Theme.BackgroundAlt},0.2)
            Stroke(inputBg,Theme.Separator,1)
            Tween(card,{BackgroundColor3=Theme.Surface},0.2)
            pcall(callback,tb.Text,enter)
        end)

        local obj={}
        function obj:Get() return tb.Text end
        function obj:Set(v) tb.Text=v end
        return obj
    end

    function Tab:AddKeybind(cfg)
        cfg=cfg or {}
        local label      = cfg.Name     or "Keybind"
        local default    = cfg.Default  or Enum.KeyCode.E
        local callback   = cfg.Callback or function() end
        local currentKey = default
        local listening  = false

        local card=Card(44)
        Create("TextLabel",{
            Size=UDim2.new(1,-120,0,44), Position=UDim2.new(0,14,0,0),
            BackgroundTransparency=1, Text=label,
            TextColor3=Theme.TextPrimary, TextSize=13, Font=Enum.Font.GothamSemibold,
            TextXAlignment=Enum.TextXAlignment.Left,
            ZIndex=5, Parent=card,
        })
        local kBtn=Create("TextButton",{
            Size=UDim2.new(0,90,0,26), Position=UDim2.new(1,-100,0.5,-13),
            BackgroundColor3=Theme.BackgroundAlt,
            Text=currentKey.Name, TextColor3=Theme.AccentGlow,
            TextSize=11, Font=Enum.Font.GothamBold,
            AutoButtonColor=false,
            ZIndex=6, Parent=card,
        })
        Corner(kBtn,8) Stroke(kBtn,Theme.Accent,1)

        kBtn.MouseButton1Click:Connect(function()
            if listening then return end
            listening=true
            kBtn.Text="Press..."
            Tween(kBtn,{BackgroundColor3=Theme.Accent,TextColor3=Color3.fromRGB(255,255,255)},0.2)
        end)
        UserInputService.InputBegan:Connect(function(inp,gp)
            if listening and inp.UserInputType==Enum.UserInputType.Keyboard then
                listening=false
                currentKey=inp.KeyCode
                kBtn.Text=inp.KeyCode.Name
                Tween(kBtn,{BackgroundColor3=Theme.BackgroundAlt,TextColor3=Theme.AccentGlow},0.2)
                pcall(callback,inp.KeyCode)
            elseif not gp and not listening and inp.KeyCode==currentKey then
                pcall(callback,currentKey)
            end
        end)

        local obj={}
        function obj:Get() return currentKey end
        return obj
    end

    function Tab:AddColorPicker(cfg)
        cfg=cfg or {}
        local label    = cfg.Name     or "Color"
        local default  = cfg.Default  or Color3.fromRGB(130,80,255)
        local callback = cfg.Callback or function() end
        local color    = default
        local isOpen   = false
        local h,s,v   = Color3.toHSV(color)

        local wrap=Create("Frame",{
            Size=UDim2.new(1,-10,0,44),
            BackgroundTransparency=1,
            ZIndex=4, Parent=page,
        })
        local main=Create("TextButton",{
            Size=UDim2.new(1,0,0,44),
            BackgroundColor3=Theme.Surface,
            Text="", AutoButtonColor=false,
            ZIndex=4, Parent=wrap,
        })
        Corner(main,12) Stroke(main,Theme.Border,1)

        Create("TextLabel",{
            Size=UDim2.new(1,-80,0,44), Position=UDim2.new(0,14,0,0),
            BackgroundTransparency=1, Text=label,
            TextColor3=Theme.TextPrimary, TextSize=13, Font=Enum.Font.GothamSemibold,
            TextXAlignment=Enum.TextXAlignment.Left,
            ZIndex=5, Parent=main,
        })
        local preview=Create("Frame",{
            Size=UDim2.new(0,26,0,26), Position=UDim2.new(1,-40,0.5,-13),
            BackgroundColor3=color, ZIndex=5, Parent=main,
        })
        Corner(preview,8) Stroke(preview,Theme.Border,1.5)

        local panel=Create("Frame",{
            Size=UDim2.new(1,0,0,0), Position=UDim2.new(0,0,0,48),
            BackgroundColor3=Theme.BackgroundAlt,
            ClipsDescendants=true, Visible=false,
            ZIndex=12, Parent=wrap,
        })
        Corner(panel,12) Stroke(panel,Theme.Border,1)
        Padding(panel,8,8,10,10)

        Create("TextLabel",{
            Size=UDim2.new(1,0,0,14),
            BackgroundTransparency=1, Text="Hue",
            TextColor3=Theme.TextMuted, TextSize=10, Font=Enum.Font.GothamBold,
            ZIndex=13, Parent=panel,
        })
        local hueTrack=Create("Frame",{
            Size=UDim2.new(1,0,0,12), Position=UDim2.new(0,0,0,16),
            BackgroundColor3=Color3.fromRGB(255,255,255),
            ZIndex=13, Parent=panel,
        })
        Corner(hueTrack,99)
        local hg=Instance.new("UIGradient")
        hg.Color=ColorSequence.new({
            ColorSequenceKeypoint.new(0/6,Color3.fromRGB(255,0,0)),
            ColorSequenceKeypoint.new(1/6,Color3.fromRGB(255,255,0)),
            ColorSequenceKeypoint.new(2/6,Color3.fromRGB(0,255,0)),
            ColorSequenceKeypoint.new(3/6,Color3.fromRGB(0,255,255)),
            ColorSequenceKeypoint.new(4/6,Color3.fromRGB(0,0,255)),
            ColorSequenceKeypoint.new(5/6,Color3.fromRGB(255,0,255)),
            ColorSequenceKeypoint.new(6/6,Color3.fromRGB(255,0,0)),
        })
        hg.Parent=hueTrack

        local hKnob=Create("Frame",{
            Size=UDim2.new(0,14,0,14), Position=UDim2.new(h,-7,0.5,-7),
            BackgroundColor3=Color3.fromRGB(255,255,255),
            ZIndex=14, Parent=hueTrack,
        })
        Corner(hKnob,99) Stroke(hKnob,Color3.fromRGB(180,180,180),1.5)

        local rgbLbl=Create("TextLabel",{
            Size=UDim2.new(1,0,0,16), Position=UDim2.new(0,0,0,34),
            BackgroundTransparency=1,
            Text=string.format("R:%d G:%d B:%d",
                math.floor(color.R*255),math.floor(color.G*255),math.floor(color.B*255)),
            TextColor3=Theme.TextSecondary, TextSize=11, Font=Enum.Font.GothamBold,
            TextXAlignment=Enum.TextXAlignment.Left,
            ZIndex=13, Parent=panel,
        })

        local function refresh()
            color=Color3.fromHSV(h,s,v)
            preview.BackgroundColor3=color
            rgbLbl.Text=string.format("R:%d G:%d B:%d",
                math.floor(color.R*255),math.floor(color.G*255),math.floor(color.B*255))
            pcall(callback,color)
        end

        local hueDrag=false
        local hBtn2=Create("TextButton",{
            Size=UDim2.new(1,0,1,0),
            BackgroundTransparency=1, Text="",
            ZIndex=15, Parent=hueTrack,
        })
        hBtn2.InputBegan:Connect(function(inp)
            if inp.UserInputType==Enum.UserInputType.MouseButton1
            or inp.UserInputType==Enum.UserInputType.Touch then
                hueDrag=true
                local p=math.clamp(
                    (inp.Position.X-hueTrack.AbsolutePosition.X)/hueTrack.AbsoluteSize.X,0,1)
                h=p
                Tween(hKnob,{Position=UDim2.new(p,-7,0.5,-7)},0.04)
                refresh()
            end
        end)
        UserInputService.InputChanged:Connect(function(inp)
            if not hueDrag then return end
            if inp.UserInputType==Enum.UserInputType.MouseMovement
            or inp.UserInputType==Enum.UserInputType.Touch then
                local p=math.clamp(
                    (inp.Position.X-hueTrack.AbsolutePosition.X)/hueTrack.AbsoluteSize.X,0,1)
                h=p
                Tween(hKnob,{Position=UDim2.new(p,-7,0.5,-7)},0.04)
                refresh()
            end
        end)
        UserInputService.InputEnded:Connect(function(inp)
            if inp.UserInputType==Enum.UserInputType.MouseButton1
            or inp.UserInputType==Enum.UserInputType.Touch then
                hueDrag=false
            end
        end)

        main.MouseButton1Click:Connect(function()
            isOpen=not isOpen
            if isOpen then
                panel.Visible=true
                Tween(panel,{Size=UDim2.new(1,0,0,60)}, 0.28,Enum.EasingStyle.Back)
                Tween(wrap, {Size=UDim2.new(1,-10,0,112)},0.28,Enum.EasingStyle.Back)
                Tween(main, {BackgroundColor3=Theme.SurfaceHover},0.15)
            else
                Tween(panel,{Size=UDim2.new(1,0,0,0)}, 0.2)
                Tween(wrap, {Size=UDim2.new(1,-10,0,44)},0.2)
                Tween(main, {BackgroundColor3=Theme.Surface},0.15)
                task.delay(0.22,function()
                    if not isOpen then panel.Visible=false end
                end)
            end
        end)
        main.MouseEnter:Connect(function()
            if not isOpen then Tween(main,{BackgroundColor3=Theme.SurfaceHover},0.15) end
        end)
        main.MouseLeave:Connect(function()
            if not isOpen then Tween(main,{BackgroundColor3=Theme.Surface},0.15) end
        end)

        local obj={}
        function obj:Get() return color end
        function obj:Set(c)
            color=c h,s,v=Color3.toHSV(c)
            preview.BackgroundColor3=c
        end
        return obj
    end

    return Tab
end

function AuraUI:Destroy()
    pcall(function()
        if self.ScreenGui then self.ScreenGui:Destroy() end
    end)
end

return AuraUI
