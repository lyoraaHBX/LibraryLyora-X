--           FADE WINDOW
-- ═══════════════════════════════════════════

local function fadeWindow(mainFrame, container, winSize, show, onDone)
    local winW = winSize.X.Offset
    local winH = winSize.Y.Offset
    if show then
        container.Size     = UDim2.new(winSize.X.Scale, winW*0.93, winSize.Y.Scale, winH*0.93)
        container.Position = UDim2.new(0.5, -(winW*0.93)/2, 0.5, -(winH*0.93)/2)
        mainFrame.BackgroundTransparency = 1
        container.Visible  = true
        local t1 = TweenService:Create(container,
            TweenInfo.new(0.36, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
            {Size=winSize, Position=UDim2.new(0.5,-winW/2,0.5,-winH/2)})
        local t2 = TweenService:Create(mainFrame,
            TweenInfo.new(0.28, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
            {BackgroundTransparency=0})
        t1.Completed:Connect(function() if onDone then onDone() end end)
        t1:Play() t2:Play()
    else
        local t1 = TweenService:Create(container,
            TweenInfo.new(0.26, Enum.EasingStyle.Quart, Enum.EasingDirection.In),
            {
                Size     = UDim2.new(winSize.X.Scale, winW*0.93, winSize.Y.Scale, winH*0.93),
                Position = UDim2.new(0.5,-(winW*0.93)/2, 0.5,-(winH*0.93)/2),
            })
        local t2 = TweenService:Create(mainFrame,
            TweenInfo.new(0.22, Enum.EasingStyle.Quart, Enum.EasingDirection.In),
            {BackgroundTransparency=1})
        t1.Completed:Connect(function()
            container.Visible  = false
            container.Size     = winSize
            container.Position = UDim2.new(0.5,-winW/2,0.5,-winH/2)
            if onDone then onDone() end
        end)
        t1:Play() t2:Play()
    end
end

