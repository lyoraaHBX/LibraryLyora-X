            TriggerBtn.Size               = UDim2.new(1, 0, 0, 32)
            TriggerBtn.BackgroundTransparency = 1
            TriggerBtn.Text               = ""
            TriggerBtn.Parent             = DropFrame

            local ListHolder = Instance.new("Frame")
            ListHolder.Size               = UDim2.new(1, -20, 0, #Options * 26)
            ListHolder.Position           = UDim2.new(0, 10, 0, 32)
            ListHolder.BackgroundTransparency = 1
            ListHolder.Parent             = DropFrame

            local ListLayout2 = Instance.new("UIListLayout")
            ListLayout2.Padding   = UDim.new(0, 2)
            ListLayout2.Parent    = ListHolder

            local function SetDropdownValue(val)
                Selected                    = val
                ValDisplay.Text             = Multi and table.concat(Selected, ", ") or tostring(Selected)
                LunoLibrary.Flags[Flag]     = Selected
                Callback(Selected)
            end

            local function RefreshOptions(NewOptions)
                for _, child in ipairs(ListHolder:GetChildren()) do
                    if child:IsA("TextButton") then child:Destroy() end
                end
                for _, opt in ipairs(NewOptions) do
                    local OptBtn = Instance.new("TextButton")
                    OptBtn.Size             = UDim2.new(1, 0, 0, 24)
                    OptBtn.BackgroundColor3 = Color3.fromRGB(22, 30, 48)
                    OptBtn.Text             = "  " .. opt
                    OptBtn.TextColor3       = Color3.fromRGB(200, 210, 230)
                    OptBtn.TextSize         = 11
                    OptBtn.Font             = Enum.Font.TitilliumWeb
                    OptBtn.TextXAlignment   = Enum.TextXAlignment.Left
                    OptBtn.Parent           = ListHolder

                    local oc = Instance.new("UICorner")
                    oc.CornerRadius = UDim.new(0, 4); oc.Parent = OptBtn

                    OptBtn.MouseButton1Click:Connect(function()
                        if Multi then
                            local idx = table.find(Selected, opt)
                            if idx then
                                table.remove(Selected, idx)
                            else
                                table.insert(Selected, opt)
                            end
                            SetDropdownValue(Selected)
                        else
                            SetDropdownValue(opt)
                            IsExpanded = false
                            TweenService:Create(DropFrame, TweenInfo.new(0.2), {
                                Size = UDim2.new(1, 0, 0, 32)
                            }):Play()
                            Arrow.Text = "▼"
                        end
                    end)
                end
                ListHolder.Size = UDim2.new(1, -20, 0, #NewOptions * 26)
            end

            RefreshOptions(Options)

            TriggerBtn.MouseButton1Click:Connect(function()
                IsExpanded = not IsExpanded
                local optCount = 0
                for _, c in ipairs(ListHolder:GetChildren()) do
                    if c:IsA("TextButton") then optCount = optCount + 1 end
                end
                local targetH = IsExpanded and (36 + optCount * 26) or 32
                TweenService:Create(DropFrame, TweenInfo.new(0.2), {
                    Size = UDim2.new(1, 0, 0, targetH)
                }):Play()
                Arrow.Text = IsExpanded and "▲" or "▼"
                task.delay(0.22, RefreshCanvas)
            end)

            LunoLibrary.Elements[Flag] = { Set = SetDropdownValue }
            RefreshCanvas()

            return { Refresh = RefreshOptions }
        end

