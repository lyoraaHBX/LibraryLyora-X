    local MaxSize = Vector2.new(ViewportSize.X - 20, ViewportSize.Y - 20)

    ResizeHitbox.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            Resizing    = true
            ResizeStart = input.Position
            StartSize   = MainFrame.AbsoluteSize
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    Resizing = false
                end
            end)
        end
    end)
    RegisterConnection(UserInputService.InputChanged:Connect(function(input)
        if Resizing and (
            input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch
        ) then
            local delta = input.Position - ResizeStart
            MainFrame.Size = UDim2.new(0,
                math.clamp(StartSize.X + delta.X, MinSize.X, MaxSize.X),
                0,
                math.clamp(StartSize.Y + delta.Y, MinSize.Y, MaxSize.Y)
