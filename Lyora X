    local function SetTabVisual(tab, active)
        if not tab.Holder then return end
        local info = TweenInfo.new(0.18)
        TweenService:Create(tab.Holder, info, {BackgroundTransparency = active and 0 or 1}):Play()
        TweenService:Create(tab.Label,  info, {TextColor3 = active and Y2K.Chrome or Y2K.TextDim}):Play()
        TweenService:Create(tab.Stroke, info, {Transparency = active and 0.3 or 1}):Play()
    end

    local function SwitchTab(TargetTab)
        for _, tab in pairs(Tabs) do
            if tab ~= TargetTab then
                SetTabVisual(tab, false)
                tab.Page.Visible = false
            end
        end
        SetTabVisual(TargetTab, true)
        TargetTab.Page.Visible = true
        ActiveTab = TargetTab
    end

