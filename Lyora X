            TabButton.TextColor3           = Color3.fromRGB(130, 150, 180)
            TabButton.TextSize             = 12
            TabButton.Font                 = Enum.Font.TitilliumWeb
            TabButton.TextXAlignment       = Enum.TextXAlignment.Left
            TabButton.LayoutOrder          = LayoutOrderValue
            TabButton.Parent               = NavContainer

            local tc = Instance.new("UICorner")
            tc.CornerRadius = UDim.new(0, 6); tc.Parent = TabButton
        end

        local TabPage = Instance.new("Frame")
        TabPage.Size               = UDim2.new(1, 0, 1, 0)
        TabPage.BackgroundTransparency = 1
        TabPage.Visible            = false
        TabPage.Parent             = ContentContainer

        local TabObj = {
            Button  = TabButton,
            Page    = TabPage,
            Hidden  = IsHidden or false,
        }
        Tabs[TabName] = TabObj

        -- Auto-select first real tab
        if not IsHidden and UserTabCounter == 1 then
