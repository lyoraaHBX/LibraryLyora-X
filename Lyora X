function LunoLibrary:Notify(Settings)
    Settings = Settings or {}
    local Title    = Settings.Title    or "Notification"
    local Content  = Settings.Content  or "Details..."
    local Duration = Settings.Duration or 3
    local Type     = Settings.Type     or "Info"
    local Accent   = ToastColors[Type] or Y2K.Neon

    if #ActiveToasts >= MAX_TOASTS then
        local oldest = table.remove(ActiveToasts, 1)
        if oldest and oldest.Parent then pcall(function() oldest:Destroy() end) end
    end

    local textW = NotifyWidth - 30
    local textH = 16
    pcall(function()
        textH = TextService:GetTextSize(Content, 13, FontBody, Vector2.new(textW, 1000)).Y
    end)
    local totalH = 30 + textH + 12

    local Toast = Create("Frame", {
        Size = UDim2.new(1, 0, 0, 0),
        BackgroundColor3 = Y2K.BgPanel2,
        ClipsDescendants = true,
        Parent = NotifyContainer,
    })
    AddCorner(Toast, 10)
    local stroke = AddChromeStroke(Toast, 1.2, 0.25, true)
    stroke.Color = Accent

    Create("Frame", {
        Size = UDim2.new(0, 3, 1, 0),
        BackgroundColor3 = Accent,
        BorderSizePixel = 0,
        Parent = Toast,
    })
    Create("TextLabel", {
        Size = UDim2.new(1, -24, 0, 20),
        Position = UDim2.new(0, 12, 0, 7),
        BackgroundTransparency = 1,
        Text = Title,
        TextColor3 = Y2K.Chrome,
        TextSize = 15,
        Font = FontBold,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = Toast,
    })
    Create("TextLabel", {
        Size = UDim2.new(1, -24, 0, textH),
        Position = UDim2.new(0, 12, 0, 30),
        BackgroundTransparency = 1,
        Text = Content,
        TextColor3 = Y2K.TextDim,
        TextSize = 13,
        Font = FontBody,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        TextWrapped = true,
        Parent = Toast,
    })

    table.insert(ActiveToasts, Toast)

    TweenService:Create(Toast,
        TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
        {Size = UDim2.new(1, 0, 0, totalH)}
    ):Play()

    task.delay(Duration, function()
        if not Toast.Parent then return end
        for i, t in ipairs(ActiveToasts) do
            if t == Toast then table.remove(ActiveToasts, i) break end
        end
        local tw = TweenService:Create(Toast,
            TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.In),
            {Size = UDim2.new(1, 0, 0, 0)}
        )
        tw:Play()
        tw.Completed:Connect(function() Toast:Destroy() end)
    end)
end

